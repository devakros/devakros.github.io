---
import Play from "../icons/play.svg?raw";
import { withBase } from "../lib/base";

/**
 * The muted, looping showreel used on Home (473x522) and on the case studies
 * (291x358).
 *
 * Autoplay is deliberately belt-and-braces. `autoplay` alone is not reliable:
 * Chrome blocks it under battery saver, data saver, or a low media-engagement
 * score on a fresh profile, and it silently stays on the poster. So we also
 * retry on canplay, on entering the viewport, and — as a last resort — on the
 * visitor's first interaction anywhere on the page.
 *
 * The footage is Victor's stand-in clip (2026-08-08), centre-cropped from a
 * 1920x1080 source to the 946x1044 portrait this slot expects, 10s at 25fps,
 * 943KB. He supplied it as a 4.6MB animated WebP; re-encoding the ORIGINAL mp4
 * instead is 5x smaller, because WebP is built for graphics and handles real
 * footage badly — the same framing came out at 4.4MB as WebP even at 640px and
 * 12fps. This element also has a sound toggle, which only a <video> can serve.
 *
 * The poster is frame 0 of this exact file, so the poster-to-playback handoff
 * is invisible. Keep that true if you re-cut it, and give the new file a NEW
 * NAME — the previous clip and poster were replaced under their old filenames
 * elsewhere in this project and browsers kept serving the stale copies.
 */
interface Props {
  src?: string;
  poster?: string;
  width: number;
  height: number;
  name: string;
  role: string;
  /** Larger reels get the bigger play affordance from the frame. */
  playSize?: number;
}
const {
  src = "/video/showreel-2026.mp4",
  poster = "/img/showreel-poster-2026.jpg",
  width,
  height,
  name,
  role,
  playSize = 66,
} = Astro.props;
---

<figure class="reel" style={`--w:${width}px; --h:${height}px; --play:${playSize}px;`}>
  <video
    data-showreel
    src={withBase(src)}
    poster={withBase(poster)}
    width={width}
    height={height}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-label={`Showreel de ${name}`}></video>

  <button
    class="reel__play"
    type="button"
    data-showreel-toggle
    data-state="muted"
    aria-label="Activar sonido"
    set:html={Play}
  />

  <figcaption class="reel__caption">
    <span class="t-body-md">{name}</span>
    <span class="t-body">{role}</span>
  </figcaption>
</figure>

<style>
  .reel {
    position: relative;
    width: var(--w);
    height: var(--h);
    flex: none;
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .reel video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Rectangle 3990 carries a #1D2222 fill at 33% over the footage. */
  .reel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(29 34 34 / 0.33);
    pointer-events: none;
  }

  .reel__play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 1;
    width: var(--play);
    height: var(--play);
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
    transition:
      scale 250ms ease,
      opacity 300ms ease;
  }
  .reel__play:hover {
    scale: 1.06;
  }
  /* Hidden once the reel is running with sound. */
  .reel__play[data-state="unmuted"] {
    opacity: 0;
    pointer-events: none;
  }
  .reel__play :global(svg) {
    width: 100%;
    height: 100%;
  }

  .reel__caption {
    position: absolute;
    left: 18px;
    bottom: 20px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    color: var(--text);
  }

  @media (max-width: 1000px) {
    .reel {
      width: 100%;
      height: auto;
      aspect-ratio: var(--w) / var(--h);
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;
  let gestureBound = false;
  // Whatever `attempt` currently points at, so the listeners at the bottom can
  // resume the reel without re-running setup.
  let resume: (() => void) | undefined;

  function boot() {
    const video = document.querySelector<HTMLVideoElement>("[data-showreel]");
    const toggle = document.querySelector<HTMLButtonElement>("[data-showreel-toggle]");
    if (!video || !toggle) return;

    // The muted *property* is what the autoplay policy checks; the attribute
    // alone can lose a race against a play() call.
    video.muted = true;

    const attempt = () => {
      if (!video.paused) return;
      video.play().catch(() => {
        // Blocked. Fall back to starting on the first interaction anywhere.
        if (gestureBound) return;
        gestureBound = true;
        const once = () => {
          video.muted = true;
          video.play().catch(() => {});
        };
        addEventListener("pointerdown", once, { once: true });
        addEventListener("keydown", once, { once: true });
        addEventListener("touchstart", once, { once: true, passive: true });
      });
    };

    // Publish the CURRENT element's attempt() before the setup guard, so the
    // listeners at the bottom can always resume even when setup is skipped.
    resume = attempt;
    attempt();

    // Everything below is one-time wiring. The guard used to sit at the very
    // top of boot() and returned before attempt() even existed — which is why
    // the reel stopped after a back navigation (per Victor, 2026-08-08).
    // ClientRouter can restore a cached DOM on popstate, and that DOM carries
    // BOTH data-ready="1" and a video the observer had paused on the way out,
    // so boot() bailed and nothing ever restarted it. Setup stays guarded;
    // resuming no longer is.
    if (video.dataset.ready) return;
    video.dataset.ready = "1";
    // Only disconnect once we know we are about to re-observe. Disconnecting
    // above the guard is how this previously ended up with no observer at all:
    // astro:page-load fires on the initial load too, so the second call tore
    // down what the first had just set up.
    io?.disconnect();

    video.addEventListener("canplay", attempt, { once: true });
    video.addEventListener("loadeddata", attempt, { once: true });

    toggle.addEventListener("click", async () => {
      video.muted = false;
      await video.play().catch(() => {});
      toggle.dataset.state = "unmuted";
      toggle.setAttribute("aria-label", "Silenciar");
    });

    // Click the reel itself to mute again and bring the button back.
    video.addEventListener("click", () => {
      if (video.muted) return;
      video.muted = true;
      toggle.dataset.state = "muted";
      toggle.setAttribute("aria-label", "Activar sonido");
    });

    // Don't burn CPU decoding a reel nobody is looking at — but always try to
    // resume when it comes back into view.
    io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) attempt();
        else video.pause();
      },
      { threshold: 0.15 },
    );
    io.observe(video);
  }

  boot();
  document.addEventListener("astro:page-load", boot);

  // The reel is paused whenever it scrolls out of view, so anything that
  // returns the visitor to a page where it is already on screen has to restart
  // it. astro:after-swap covers a restored DOM, pageshow covers the browser's
  // own bfcache on a full back/forward, and visibilitychange covers coming
  // back to a backgrounded tab. All three are cheap: attempt() returns
  // immediately when the video is already playing.
  document.addEventListener("astro:after-swap", () => resume?.());
  window.addEventListener("pageshow", () => resume?.());
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) resume?.();
  });
</script>
