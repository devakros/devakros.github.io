---
import { withBase } from "../lib/base";

/**
 * The muted, looping showreel used on Home (473x434, a la altura del slider).
 *
 * Player: Media Chrome (media-chrome) — controles nativos estilables:
 * play/pausa, -15s/+15s, mute, volumen, tiempo y fullscreen. Accessibility y
 * teclado incluidos.
 *
 * Autoplay is deliberately belt-and-braces. `autoplay` alone is not reliable:
 * Chrome blocks it under battery saver, data saver, or a low media-engagement
 * score on a fresh profile, and it silently stays on the poster. So we also
 * retry on canplay, on entering the viewport, and — as a last resort — on the
 * visitor's first interaction anywhere on the page.
 *
 * The current footage is Victor's own clip (VideoVictor.mp4, 1440x1080 4:3,
 * 25fps, 44s, 51MB) re-encoded to 946x710, 25fps CFR, h264, 5.2MB with
 * lanczos — decoding 4x fewer pixels and constant frames keeps the reel
 * smooth, and the file is ~10x lighter. The home slot shows it at 473x434
 * (borde a borde con el slider), con object-fit cover que recorta apenas el
 * 4:3 en su estado natural.
 *
 * The poster is frame 0 of this exact file, so the poster-to-playback handoff
 * is invisible. Keep that true if you re-cut it, and give the new file a NEW
 * NAME — the previous clips and posters were replaced under their old
 * filenames elsewhere in this project and browsers kept serving the stale
 * copies.
 */
interface Props {
  src?: string;
  poster?: string;
  width: number;
  height: number;
  name: string;
  role: string;
}
const {
  src = "/video/showreel-2026-victor.mp4",
  poster = "/img/showreel-poster-2026-victor.jpg",
  width,
  height,
  name,
  role,
} = Astro.props;
---

<figure class="reel" style={`--w:${width}px; --h:${height}px;`}>
  <media-controller class="reel__player">
    <video
      slot="media"
      data-showreel
      src={withBase(src)}
      poster={withBase(poster)}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      disablepictureinpicture
      aria-label={`Showreel de ${name}`}></video>

    <media-control-bar slot="controls">
      <media-play-button></media-play-button>
      <media-seek-backward-button seek-offset="15"></media-seek-backward-button>
      <media-seek-forward-button seek-offset="15"></media-seek-forward-button>
      <media-mute-button></media-mute-button>
      <media-volume-range></media-volume-range>
      <media-time-display></media-time-display>
      <media-fullscreen-button></media-fullscreen-button>
    </media-control-bar>
  </media-controller>

  <figcaption class="reel__caption">
    <span class="t-body-md">{name}</span>
    <span class="t-body">{role}</span>
  </figcaption>
</figure>

<style>
  .reel {
    position: relative;
    width: var(--w);
    height: var(--h);
    flex: none;
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }

  .reel video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Rectangle 3990 carries a #1D2222 fill at 33% over the footage. Debajo de
     los controles (z-index), encima del video. */
  .reel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgb(29 34 34 / 0.33);
    pointer-events: none;
  }

  /* Media Chrome: temas oscuros/dorados del sitio. */
  .reel__player {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    font-family: var(--font);
    --media-control-background: transparent;
    --media-control-hover-background: rgb(29 34 34 / 0.85);
    --media-control-icon-color: #fff;
    --media-control-icon-size: 18px;
    --media-range-track-height: 4px;
    --media-range-thumb-height: 12px;
    --media-range-thumb-width: 12px;
    --media-range-track-background: rgb(255 255 255 / 0.25);
    --media-range-bar-color: var(--accent);
    --media-time-display-background: transparent;
    --media-time-display-color: #fff;
    --media-control-bar-spacing: 4px;
  }

  .reel__caption {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    color: var(--text);
    transition: bottom 200ms ease;
    pointer-events: none;
  }
  /* Con los controles visibles (usuario activo), la leyenda sube por encima
     de la barra de control. */
  .reel__player:not([user-inactive]) .reel__caption {
    bottom: 58px;
  }

  @media (max-width: 1000px) {
    .reel {
      width: 100%;
      height: auto;
      aspect-ratio: var(--w) / var(--h);
    }
  }
</style>

<script>
  import "media-chrome";

  let io: IntersectionObserver | undefined;
  let gestureBound = false;
  // Whatever `attempt` currently points at, so the listeners at the bottom can
  // resume the reel without re-running setup.
  let resume: (() => void) | undefined;

  function boot() {
    const video = document.querySelector<HTMLVideoElement>("[data-showreel]");
    if (!video) {
      // Clear it, or the listeners at the bottom keep calling play() on the
      // PREVIOUS page's detached <video> — and the closure holds that element
      // and its media buffer alive for the rest of the session.
      resume = undefined;
      return;
    }

    // The muted *property* is what the autoplay policy checks; the attribute
    // alone can lose a race against a play() call.
    video.muted = true;

    const attempt = () => {
      if (!video.paused) return;
      video.play().catch(() => {
        // Blocked. Fall back to starting on the first interaction anywhere.
        if (gestureBound) return;
        gestureBound = true;
        const once = () => {
          video.muted = true;
          video.play().catch(() => {});
        };
        addEventListener("pointerdown", once, { once: true });
        addEventListener("keydown", once, { once: true });
        addEventListener("touchstart", once, { once: true, passive: true });
      });
    };

    // Publish the CURRENT element's attempt() before the setup guard, so the
    // listeners at the bottom can always resume even when setup is skipped.
    resume = attempt;
    attempt();

    // Everything below is one-time wiring. The guard used to sit at the very
    // top of boot() and returned before attempt() even existed — which is why
    // the reel stopped after a back navigation (per Victor, 2026-08-08).
    // ClientRouter can restore a cached DOM on popstate, and that DOM carries
    // BOTH data-ready="1" and a video the observer had paused on the way out,
    // so boot() bailed and nothing ever restarted it. Setup stays guarded;
    // resuming no longer is.
    if (video.dataset.ready) return;
    video.dataset.ready = "1";
    // Only disconnect once we know we are about to re-observe. Disconnecting
    // above the guard is how this previously ended up with no observer at all:
    // astro:page-load fires on the initial load too, so the second call tore
    // down what the first had just set up.
    io?.disconnect();

    video.addEventListener("canplay", attempt, { once: true });
    video.addEventListener("loadeddata", attempt, { once: true });

    // Don't burn CPU decoding a reel nobody is looking at — but always try to
    // resume when it comes back into view.
    io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) attempt();
        else video.pause();
      },
      { threshold: 0.15 },
    );
    io.observe(video);
  }

  boot();
  document.addEventListener("astro:page-load", boot);

  // The reel is paused whenever it scrolls out of view, so anything that
  // returns the visitor to a page where it is already on screen has to restart
  // it. astro:after-swap covers a restored DOM, pageshow covers the browser's
  // own bfcache on a full back/forward, and visibilitychange covers coming
  // back to a backgrounded tab. All three are cheap: attempt() returns
  // immediately when the video is already playing.
  document.addEventListener("astro:after-swap", () => resume?.());
  window.addEventListener("pageshow", () => resume?.());
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) resume?.();
  });
</script>