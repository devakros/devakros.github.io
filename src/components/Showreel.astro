---
import { withBase } from "../lib/base";

/**
 * Showreel de Home (473x434, a la altura del slider).
 *
 * El video del hero es un PREVIEW: autoplay silenciado en loop, sin
 * controles. Un clic en cualquier parte del reel abre un MODAL (<dialog>
 * nativo) que reproduce el mismo clip DESDE EL INICIO CON SONIDO y con los
 * controles nativos del navegador (play/pausa, seek, volumen, fullscreen).
 * El modal cierra con ESC, con el botón X, o haciendo clic fuera (backdrop).
 *
 * Autoplay is deliberately belt-and-braces. `autoplay` alone is not reliable:
 * Chrome blocks it under battery saver, data saver, or a low media-engagement
 * score on a fresh profile, and it silently stays on the poster. So we also
 * retry on canplay, on entering the viewport, and — as a last resort — on the
 * visitor's first interaction anywhere on the page.
 *
 * The current footage is Victor's own clip (VideoVictor.mp4, 1440x1080 4:3,
 * 25fps, 44s, 51MB with aac stereo) re-encoded to 946x710, 25fps CFR, h264 +
 * aac 128k, 5.9MB with lanczos — decoding 4x fewer pixels and constant
 * frames keeps the reel smooth, and the file is ~9x lighter. El sufijo "-a"
 * indica que llevA AUDIO (los re-encodes con -an salían mudos — no repetir).
 * En el hero va muted; el audio solo suena en el modal.
 *
 * The poster is frame 0 of this exact file, so the poster-to-playback handoff
 * is invisible. Keep that true if you re-cut it, and give the new file a NEW
 * NAME — the previous clips and posters were replaced under their old
 * filenames elsewhere in this project and browsers kept serving the stale
 * copies.
 */
interface Props {
  src?: string;
  poster?: string;
  width: number;
  height: number;
  name: string;
  role: string;
}
const {
  src = "/video/showreel-2026-victor-a.mp4",
  poster = "/img/showreel-poster-2026-victor-a.jpg",
  width,
  height,
  name,
  role,
} = Astro.props;
---

<figure class="reel" style={`--w:${width}px; --h:${height}px;`} data-reel>
  <video
    data-showreel
    src={withBase(src)}
    poster={withBase(poster)}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-label={`Showreel de ${name} (preview)`}></video>

  <button class="reel__play" type="button" data-reel-open aria-label="Reproducir con sonido">
    <img src={withBase("/img/play-circle.png")} alt="" width="66" height="66" />
  </button>

  <figcaption class="reel__caption">
    <span class="t-body-md">{name}</span>
    <span class="t-body">{role}</span>
  </figcaption>
</figure>

<dialog class="reel__modal" data-reel-modal aria-label={`Showreel de ${name}, con sonido`}>
  <video
    data-reel-modal-video
    src={withBase(src)}
    poster={withBase(poster)}
    controls
    playsinline
    preload="auto"
    disablepictureinpicture
    aria-label={`Showreel de ${name}, con sonido`}></video>
  <button class="reel__modal-close" type="button" data-reel-close aria-label="Cerrar">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</dialog>

<style>
  .reel {
    position: relative;
    width: var(--w);
    height: var(--h);
    flex: none;
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
  }

  .reel video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Rectangle 3990 carries a #1D2222 fill at 33% over the footage.
     Al pasar el cursor se desvanece para leer el preview a plena luz. */
  .reel::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgb(29 34 34 / 0.33);
    pointer-events: none;
    transition: opacity 250ms ease;
  }
  .reel:hover::after {
    opacity: 0;
  }

  .reel__play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 2;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.5));
    /* Pulso sutil: invita al clic sin robar protagonismo. */
    animation: reel-pulse 2.4s ease-in-out infinite;
  }
  .reel__play img {
    width: 66px;
    height: 66px;
    display: block;
  }
  .reel__play:hover {
    scale: 1.12;
    animation-play-state: paused;
  }
  @keyframes reel-pulse {
    0%,
    100% {
      scale: 1;
    }
    50% {
      scale: 1.08;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .reel__play {
      animation: none;
    }
  }

  .reel__caption {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    color: var(--text);
    pointer-events: none;
  }

  /* ── Modal ─────────────────────────────────────────────────────────── */
  .reel__modal {
    padding: 0;
    border: 0;
    border-radius: var(--r-md);
    background: #000;
    width: min(92vw, 960px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .reel__modal[open] {
    max-width: none;
  }
  .reel__modal::backdrop {
    background: rgb(13 17 17 / 0.9);
  }
  .reel__modal video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .reel__modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 1;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(26 30 30 / 0.85);
    color: #fff;
    cursor: pointer;
  }
  .reel__modal-close svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1000px) {
    .reel {
      width: 100%;
      height: auto;
      aspect-ratio: var(--w) / var(--h);
    }
  }
</style>

<script>
  let io: IntersectionObserver | undefined;
  let gestureBound = false;
  // Whatever `attempt` currently points at, so the listeners at the bottom can
  // resume the reel without re-running setup.
  let resume: (() => void) | undefined;

  function boot() {
    const video = document.querySelector<HTMLVideoElement>("[data-showreel]");
    const reel = document.querySelector<HTMLElement>("[data-reel]");
    const modal = document.querySelector<HTMLDialogElement>("[data-reel-modal]");
    const modalVideo = document.querySelector<HTMLVideoElement>("[data-reel-modal-video]");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-reel-open]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-reel-close]");

    if (!video) {
      // Clear it, or the listeners at the bottom keep calling play() on the
      // PREVIOUS page's detached <video> — and the closure holds that element
      // and its media buffer alive for the rest of the session.
      resume = undefined;
      return;
    }

    // The muted *property* is what the autoplay policy checks; the attribute
    // alone can lose a race against a play() call.
    video.muted = true;

    const attempt = () => {
      if (!video.paused) return;
      video.play().catch(() => {
        // Blocked. Fall back to starting on the first interaction anywhere.
        if (gestureBound) return;
        gestureBound = true;
        const once = () => {
          video.muted = true;
          video.play().catch(() => {});
        };
        addEventListener("pointerdown", once, { once: true });
        addEventListener("keydown", once, { once: true });
        addEventListener("touchstart", once, { once: true, passive: true });
      });
    };

    // Publish the CURRENT element's attempt() before the setup guard, so the
    // listeners at the bottom can always resume even when setup is skipped.
    resume = attempt;
    attempt();

    if (video.dataset.ready) return;
    video.dataset.ready = "1";
    io?.disconnect();

    video.addEventListener("canplay", attempt, { once: true });
    video.addEventListener("loadeddata", attempt, { once: true });

    io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) attempt();
        else video.pause();
      },
      { threshold: 0.15 },
    );
    io.observe(video);

    // ── Modal: preview → reproducción con sonido desde el inicio ──────
    if (reel && modal && modalVideo && openBtn && closeBtn) {
      const open = () => {
        // El click es el gesto que permite audio; arrancamos del inicio.
        modalVideo.currentTime = 0;
        modalVideo.muted = false;
        modal.showModal();
        modalVideo.play().catch(() => {});
        // El preview queda en pausa mientras el modal está abierto.
        video.pause();
      };
      const close = () => {
        modal.close();
      };
      const onClose = () => {
        modalVideo.pause();
        // El preview retoma su autoplay donde quedó.
        attempt();
      };

      openBtn.addEventListener("click", open);
      reel.addEventListener("click", open);
      // El video del modal tiene sus propios controles: clic dentro NO cierra.
      modalVideo.addEventListener("click", (e) => e.stopPropagation());
      closeBtn.addEventListener("click", close);
      modal.addEventListener("click", (e) => {
        // Clic sobre el backdrop (el evento llega al dialog) cierra.
        if (e.target === modal) close();
      });
      modal.addEventListener("close", onClose);
    }
  }

  boot();
  document.addEventListener("astro:page-load", boot);

  // The reel is paused whenever it scrolls out of view, so anything that
  // returns the visitor to a page where it is already on screen has to restart
  // it. astro:after-swap covers a restored DOM, pageshow covers the browser's
  // own bfcache on a full back/forward, and visibilitychange covers coming
  // back to a backgrounded tab. All three are cheap: attempt() returns
  // immediately when the video is already playing.
  document.addEventListener("astro:after-swap", () => resume?.());
  window.addEventListener("pageshow", () => resume?.());
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) resume?.();
  });
</script>