---
import Base from "../../layouts/Base.astro";
import Nav from "../Nav.astro";
import SiteFooter from "../SiteFooter.astro";
import ProjectSlider, { type Slide } from "../ProjectSlider.astro";
import { getProjects, bySlug } from "../../data/projects";
import { getCase } from "../../data/cases";
import { withBase } from "../../lib/base";
import { getLangFromUrl, homePath, projectsPath, projectPath } from "../../i18n";
import { useTranslations } from "../../i18n/ui";

/**
 * Figma node 898:2 "Coca cola" — 1280x3523, page 3.0.
 *
 * Built as real markup rather than the frame render. The three product
 * mockups in the right column stay as exported PNGs: each is a composed UI
 * screenshot with 100+ nested image fills, so rebuilding them in HTML would
 * be reconstructing Coca-Cola's product, not Victor's design.
 *
 * Layout note: the hero and the related-projects band use the 962px grid, but
 * the case body runs wider — x=47..1236 (1189px) in the frame.
 *
 * Rendered once per locale by `src/pages/proyectos/coca-cola.astro` and
 * `src/pages/en/projects/coca-cola.astro`. All copy lives in
 * `src/data/cases.ts`; nothing user facing is typed into this file.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const project = bySlug("coca-cola", lang)!;
const study = getCase("coca-cola", lang);

// The hero paragraph bolds the product and the client, exactly as the frame does.
const boldSplit = (text: string) =>
  text.split(/(\*\*[^*]+\*\*)/).map((part) =>
    part.startsWith("**") && part.endsWith("**")
      ? { bold: true, text: part.slice(2, -2) }
      : { bold: false, text: part },
  );

const slides: Slide[] = getProjects(lang).map((p) => ({
  title: p.title,
  img: p.img,
  alt: p.alt,
  tags: p.cardTags ?? p.tags,
  desc: p.desc,
  href: withBase(projectPath(p.slug, lang)),
  placeholder: p.placeholder,
}));

const pageTitle =
  lang === "en" ? `${project.title} | Victor Vivas` : `${project.title} — Victor Vivas`;
---

<Base title={pageTitle} description={study.description}>
  <Nav />

  <main>
    <!-- ── Hero (962 grid) ─────────────────────────────────────────────── -->
    <section class="hero container">
      <div class="hero__grid">
        <div class="hero__left">
          <a class="back" href={withBase(homePath[lang])}>
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M14 5 7.5 12l6.5 7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {t("case.back")}
          </a>

          {/* El showreel se quitó (2026-08-19); reservamos su hueco exacto
              para que el hero y el body no se muevan. */}
          <div class="hero__space" aria-hidden="true"></div>
        </div>

        <div class="hero__right">
          {/* Two-tone via character overrides in the frame: the clause up to the
              colon is mint, the rest is muted. */}
          <h1 class="t-h2 hero__title">
            {study.headline.base} <span class="muted">{study.headline.muted}</span>
          </h1>

          <ul class="tags">
            {project.tags.map((tag) => <li class="tag">{tag}</li>)}
          </ul>

          <p class="hero__desc">
            {boldSplit(study.intro).map((part) => (part.bold ? <strong>{part.text}</strong> : part.text))}
          </p>

          <p class="hero__meta">
            <span>{study.meta.year}</span>
            <span class="dot" aria-hidden="true"></span>
            <span>{t("case.launchedBy")} {study.meta.client}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- ── Case body (wider grid, #212626 band) ───────────────────────── -->
    <section class="case">
      <div class="case__grid container-wide">
        <div class="case__copy">
          {
            study.blocks.map((block) => (
              <section class="block">
                <h2 class="block__heading">{block.heading}</h2>
                {block.lead && <p class="block__lead">{block.lead}</p>}
                {block.paras?.map((para) => <p class="block__para">{para}</p>)}
                {block.bullets && (
                  <dl class="block__list">
                    {block.bullets.map((item) => (
                      <div class="block__item">
                        <dt>
                          <img class="pin" src={withBase("/img/pushpin.png")} alt="" width="18" height="18" />
                          {item.term}
                        </dt>
                        <dd>{item.body}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </section>
            ))
          }
        </div>

        <div class="case__shots">
          {
            study.shots.map((shot, i) => (
              <figure class="shot">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  width={shot.w}
                  height={shot.h}
                  loading={i === 0 ? "eager" : "lazy"}
                />
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Related projects (962 grid) ────────────────────────────────── -->
    <section class="related">
      <div class="related__grid container">
        <div class="related__intro">
          <h2 class="t-h2 related__title">{t("case.related.title")}</h2>
          <p class="related__desc">{t("case.related.desc")}</p>
          <a class="related__cta" href={withBase(projectsPath[lang])}>
            {t("case.related.cta")}
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>

        <ProjectSlider slides={slides} />
      </div>
    </section>

    <!-- ── Light footer band (y=3202 in the frame) ────────────────────── -->
    <section class="light theme-light" data-theme-light id="resumen">
      <hr class="rule container" />
      <SiteFooter home={false} />
    </section>
  </main>
</Base>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────
     Volver and the title share a baseline at y=143; the reel drops to y=192
     under the back link. Columns are 291 and 600 with a 71px gutter. */
  /* Nav already contributes its own 29px margin-bottom, so this is the
     remainder: 100 (nav bottom) + 29 + 14 = 143 (Volver). */
  .hero {
    padding-top: 14px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 291px 600px;
    gap: 71px;
    align-items: start;
  }

  .hero__left {
    display: flex;
    flex-direction: column;
  }
  /* Volver ends y=167, el espacio del showreel arranca en y=192. Showreel
     quitado (2026-08-19): solo dimensiones, vacío de verdad, para no mover
     el resto de la página. */
  .hero__space {
    margin-top: 25px;
    width: 291px;
    height: 358px;
    flex: none;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    height: 24px;
    font-size: 18px;
    line-height: 22.7px;
    font-weight: 300;
    color: var(--text);
    transition: opacity 200ms ease;
  }
  .back svg {
    width: 20px;
    height: 20px;
    transition: translate 200ms ease;
  }
  .back:hover {
    opacity: 0.75;
  }
  .back:hover svg {
    translate: -3px 0;
  }

  /* Frame 153 — vertical, 20px gaps. */
  .hero__right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero__title {
    margin: 0;
    color: var(--text);
  }
  .muted {
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    padding: 6px 8px;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    color: var(--accent);
    font-size: 12px;
    line-height: 10px;
    font-weight: 500;
  }

  .hero__desc {
    margin: 0;
    font-size: 18px;
    line-height: 22.7px;
    font-weight: 300;
    color: var(--text);
  }
  .hero__desc strong {
    font-weight: 600;
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
  }
  .hero__meta .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ── Case body ────────────────────────────────────────────────────────
     Full-bleed #212626 band, y=586..2584. Copy column 450px, shots 678px,
     61px gutter — wider than the 962 grid the rest of the page uses. */
  .case {
    margin-top: 36px; /* hero reel ends y=550 -> band starts y=586 */
    padding: 83px 0 126px;
    background: var(--surface-alt);
  }

  .case__grid {
    display: grid;
    grid-template-columns: 450px 678px;
    gap: 61px;
    align-items: start;
  }

  .case__copy {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .block__heading {
    margin: 0;
    font-size: 20px;
    line-height: 30px;
    font-weight: 400;
    color: var(--muted);
  }

  .block__lead {
    margin: 0;
    font-size: 25px;
    line-height: 30px;
    font-weight: 400;
    color: var(--text);
  }

  .block__para {
    margin: 0;
    /* One frame text node can carry an internal line break (U+2028). */
    white-space: pre-line;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
  }

  .block__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
  }
  /* Terms sit behind an 18px pushpin at the column edge (x=47), so the text
     itself starts at x=70; the body below is not indented. */
  .block__item dt {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 600;
    color: var(--text);
  }
  .pin {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .block__item dd {
    margin: 5px 0 0;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
  }

  /* Frame 1000003345 — vertical, 34px gaps. */
  .case__shots {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  .shot {
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }
  .shot img {
    width: 100%;
    height: auto;
  }

  /* ── Related projects ─────────────────────────────────────────────── */
  .related {
    padding-top: 100px; /* section y=2587 -> slider y=2687 */
    padding-bottom: 100px;
  }

  .related__grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 130px;
  }

  .related__intro {
    width: 369px;
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 71px; /* intro y=2758 vs slider y=2687 */
  }

  .related__title {
    margin: 0;
    max-width: 345px;
    color: var(--muted);
  }

  .related__desc {
    margin: 0;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--muted);
  }

  .related__cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 5px;
    padding: 9px 10px;
    border-radius: var(--r-sm);
    background: var(--accent);
    color: #1d2222;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 400;
  }
  .related__cta svg {
    width: 18px;
    height: 18px;
    transition: translate 250ms ease;
  }
  .related__cta:hover svg {
    translate: 4px -4px;
  }

  /* ── Light footer band ────────────────────────────────────────────── */
  .light {
    background: var(--bg);
    color: var(--text);
    padding-bottom: 30px;
  }
  .rule {
    height: 1px;
    margin: 0 auto;
    border: 0;
    background: var(--rule);
  }

  /* ── Responsive ───────────────────────────────────────────────────────
     No mobile frames exist for this page either — invented, needs review. */
  @media (max-width: 1240px) {
    .case__grid {
      grid-template-columns: minmax(0, 450px) minmax(0, 678px);
      gap: 40px;
    }
  }

  @media (max-width: 1000px) {
    .hero__grid,
    .case__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .case {
      padding: 56px 0 64px;
    }
    .related {
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .related__grid {
      flex-direction: column;
      gap: 40px;
    }
    .related__intro {
      width: 100%;
      margin-top: 0;
    }
  }
</style>
