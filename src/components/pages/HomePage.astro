---
import Base from "../../layouts/Base.astro";
import Nav from "../Nav.astro";
import LocalClock from "../LocalClock.astro";
import ProjectSlider, { type Slide } from "../ProjectSlider.astro";
import Testimonials from "../Testimonials.astro";
import SiteFooter from "../SiteFooter.astro";
import Showreel from "../Showreel.astro";
import { getProjects } from "../../data/projects";
import { withBase } from "../../lib/base";
import { getLangFromUrl, projectPath } from "../../i18n";
import { useTranslations } from "../../i18n/ui";

import Diamond from "../../icons/diamond.svg?raw";
import Handshake from "../../icons/handshake.svg?raw";
import Signature from "../../icons/signature.svg?raw";
import LogoFigma from "../../icons/logo-figma.svg?raw";
import LogoFramer from "../../icons/logo-framer.svg?raw";

/**
 * Home, rendered once per locale. `src/pages/index.astro` and
 * `src/pages/en/index.astro` are thin routes over this component, so the two
 * language versions cannot drift apart in layout or behaviour — only the copy
 * differs, and that copy lives in `src/i18n/ui.ts` and `src/data/`.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// The slider and the case-study routes read from one source of truth.
const slides: Slide[] = getProjects(lang).map((project) => ({
  title: project.title,
  img: project.img,
  alt: project.alt,
  tags: project.cardTags ?? project.tags,
  desc: project.desc,
  href: withBase(projectPath(project.slug, lang)),
  placeholder: project.placeholder,
}));

const kpis = [
  { icon: Diamond, stat: "+8", label: t("home.kpi1.label"), body: t("home.kpi1.body") },
  { icon: Handshake, stat: "+4", label: t("home.kpi2.label"), body: t("home.kpi2.body") },
  { icon: Signature, stat: "+17", label: t("home.kpi3.label"), body: t("home.kpi3.body") },
];

// Marquee row (Component 4). Rendered twice for the seamless loop — the Figma
// frame does the same thing: two identical 910px groups inside a 1890px track.
const tools = [
  { name: "Spline", img: withBase("/img/logo-spline.png"), size: 34 },
  { name: "Figma", svg: LogoFigma },
  { name: "Useberry", img: withBase("/img/logo-useberry.png"), size: 38 },
  { name: "Framer", svg: LogoFramer },
  { name: "ChatGPT", img: withBase("/img/logo-gpt.png"), size: 40 },
  { name: "Slack", img: withBase("/img/logo-slack.png"), size: 38 },
  { name: "Relume", img: withBase("/img/logo-relume.png"), size: 38 },
];

// Fewer visible slots than logos, so there's always a spare to rotate in
// without two slots showing the same logo.
const LOGO_SLOTS = 5;

const heroSep = t("home.hero.sep");

const title = t("home.title");
const description = t("home.description");
---

<Base title={title} description={description}>
  <Nav />

  <main>
    <!-- ── Hero ───────────────────────────────────────────────────────── -->
    <section class="hero container">
      <div class="hero__top">
        {/* The separator is part of the Spanish lockup ("IA - Powered"). English
            has no such convention, so `home.hero.sep` is empty there and the
            mark is not rendered at all. */}
        <h1 class="t-h2 hero__title" data-intro-title>
          {t("home.hero.lead")}{heroSep && (
            <>
              {" "}
              <span class="muted">{heroSep}</span>
            </>
          )} {t("home.hero.base")} <span class="muted">{t("home.hero.muted")}</span>
        </h1>
        <div data-intro-hide><LocalClock size="hero" /></div>
      </div>

      <div class="hero__row" id="proyectos" data-intro-hide>
        <ProjectSlider slides={slides} />

        <Showreel
          width={473}
          height={434}
          name="Victor Vivas"
          role="Product Designer"
          {...(lang === "en"
            ? {
                src: "/video/showreel-2026-victor-en-a.mp4",
                poster: "/img/showreel-poster-2026-victor-en-a.jpg",
              }
            : {})}
        />
      </div>
    </section>

    {/* ── Statement + KPIs. A band, but NOT the trigger: it changes when the
        logo wall below it reaches the switch line, not when it does. ── */}
    <section class="approach band" id="sobre-mi" data-band data-intro-hide>
      <p class="t-h1 approach__statement container" data-reveal data-reveal-blur>
        {t("home.approach.base")} <span class="muted">{t("home.approach.muted")}</span>
      </p>

      <div class="kpis container">
        {
          kpis.map((kpi, i) => (
            <article class="kpi" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
              <span class="kpi__icon" aria-hidden="true" set:html={kpi.icon} />
              <div class="kpi__headline">
                <span class="t-stat">{kpi.stat}</span>
                <span class="t-label">{kpi.label}</span>
              </div>
              <p class="t-body kpi__body">{kpi.body}</p>
            </article>
          ))
        }
      </div>

    </section>

    {/* ── Logo band. This one carries [data-band-trigger]: the toggle happens
        when the brand logos reach the switch line, and all three bands change
        on that single moment. Do not move the trigger elsewhere. ── */}
    <section class="logo-band band" data-band data-band-trigger data-intro-hide>
      <div class="logowall container" aria-label={t("home.tools.aria")} data-logowall>
        {
          Array.from({ length: LOGO_SLOTS }).map((_, s) => (
            <div class="logoslot">
              {tools.map((tool, i) => (
                <span class:list={["logoslot__item", i === s && "is-on"]}>
                  {tool.svg ? (
                    <span class="tool" title={tool.name} set:html={tool.svg} />
                  ) : (
                    <span class="tool">
                      <img
                        src={tool.img}
                        alt={tool.name}
                        width={tool.size}
                        height={tool.size}
                        loading="lazy"
                      />
                    </span>
                  )}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    {/* ── Testimonials + footer. Per Victor this starts DARK and flips with the
        other two, rather than being permanently light the way the case-study
        footers still are. Also not the trigger. ── */}
    <section class="light band" data-band id="resumen" data-intro-hide>
      <h2 class="t-h2 light__title container" data-reveal>{t("home.testimonials.title")}</h2>

      <div data-reveal><Testimonials /></div>

      <hr class="rule container" />

      <SiteFooter />
    </section>
  </main>
</Base>

<script>
  // Static logo wall: every few seconds one slot cross-fades to a different
  // logo. Slots are staggered so they never all change at once, and a logo
  // that's currently on screen elsewhere is skipped so no two slots match.
  let wallTimer = 0;

  function bootLogowall() {
    const wall = document.querySelector<HTMLElement>("[data-logowall]");
    if (!wall) return;
    // Reduced motion: leave the wall completely static.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const slots = [...wall.querySelectorAll<HTMLElement>(".logoslot")];
    if (!slots.length) return;
    const total = slots[0].children.length;
    const slotCount = slots.length;
    const state = slots.map((_, s) => s % total);
    let cursor = 0;

    window.clearInterval(wallTimer);
    wallTimer = window.setInterval(() => {
      const s = cursor % slotCount;
      cursor++;

      // Which logos are visible in the *other* slots right now.
      const shown = new Set(state.filter((_, i) => i !== s));
      let next = (state[s] + slotCount) % total;
      let guard = 0;
      while (shown.has(next) && guard++ < total) next = (next + 1) % total;
      if (next === state[s]) return;

      slots[s].children[state[s]]?.classList.remove("is-on");
      slots[s].children[next]?.classList.add("is-on");
      state[s] = next;
    }, 1600);
  }

  // The interval outlives a client-side navigation otherwise.
  document.addEventListener("astro:before-swap", () => window.clearInterval(wallTimer));
  bootLogowall();
  document.addEventListener("astro:page-load", bootLogowall);
</script>

<style>
  .muted {
    color: var(--muted);
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  .hero__title {
    max-width: 405px; /* Figma text node is 405x105 — the wrap is deliberate */
    margin: 0;
    color: var(--text);
  }

  /* Card column starts at y=393, video column at y=286 — same 27px gutter,
     different top offsets, both ending at y=808. (2026-08-20: both ahora
     comparten el mismo top para quedar alineados.) */
  .hero__row {
    display: flex;
    align-items: flex-start;
    gap: 27px;
    margin-top: 52px;
  }

  /* Slider y video comparten el mismo top (107px): alineados (2026-08-20). */
  .hero__row > :global(.slider) {
    margin-top: 107px;
  }
  .hero__row > :global(.reel) {
    margin-top: 107px;
  }

  /* ── Approach ─────────────────────────────────────────────────────────
     The 116px above the statement is split 46 margin / 70 padding, and the
     40px that used to be the logo band's margin-top is now this band's
     padding-bottom. Same rhythm as before, but the border box is exactly the
     light surface — which is what the flip trigger measures. Do not turn
     either padding back into a margin. */
  .approach {
    margin-top: 46px;
    padding-top: 70px;
    padding-bottom: 40px;
    display: flex;
    flex-direction: column;
    gap: 127px; /* Frame 148 itemSpacing */
  }

  .approach__statement {
    margin: 0 auto;
    /* min() so it caps at 917 on desktop but never exceeds the viewport on
       mobile (the fixed 917px was overriding the .container cap → overflow). */
    max-width: min(917px, 100%);
    text-align: center;
    color: var(--text);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 27px;
  }

  .kpi {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 25px;
    background: var(--surface);
    border-radius: var(--r-md);
  }
  /* Cards sobre la logo wall — en claro quedan en el tono cálido solicitado
     (2026-08-20); en oscuro mantienen el surface del tema. */
  .approach.is-light .kpi {
    background: #dcd7c5;
  }

  .kpi__icon {
    width: 34px;
    height: 34px;
    color: var(--accent);
  }
  .kpi__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .kpi__headline {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
  }

  .kpi__body {
    margin: 0;
    color: var(--text);
  }

  /* ── Tool logo wall ───────────────────────────────────────────────── */
  .logowall {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    /* Keeps the row from stretching edge-to-edge on wide viewports. */
    max-width: 820px;
    margin-inline: auto;
  }

  .logoslot {
    position: relative;
    width: 70px;
    height: 70px;
    flex: none;
  }

  /* All logos for a slot stack in the same box; the crossfade swaps which one
     is lit. Outgoing blurs + shrinks as it fades, incoming does the reverse —
     the closest thing to a "morph" that works across mixed PNG/SVG brand marks
     (a true path morph isn't possible between unrelated logos). */
  .logoslot__item {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    filter: blur(7px);
    transform: scale(0.86);
    transition:
      opacity 900ms ease,
      filter 900ms ease,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .logoslot__item.is-on {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }

  .tool {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    /* The logo row now lives on the light band — currentColor SVG marks (Framer
       etc.) take the dark text colour so they stay visible on white. */
    color: var(--text);
  }
  .tool :global(svg) {
    max-width: 42px;
    max-height: 42px;
  }

  /* Keep the five marks on ONE row and let them shrink, rather than wrapping.
     Wrapping split them 4+1 at 390-414px — a lone logo on its own line reads
     as a mistake — and 3+2 only by luck at 360. Five equal slots that flex
     down always looks deliberate. */
  @media (max-width: 720px) {
    .logowall {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 8px;
    }
    .logoslot {
      width: auto;
      height: auto;
      flex: 1 1 0;
      max-width: 70px;
      aspect-ratio: 1;
    }
    .tool {
      width: 100%;
      height: 100%;
    }
    .tool :global(svg),
    .tool :global(img) {
      max-width: 62%;
      max-height: 62%;
      width: auto;
      height: auto;
    }
  }

  /* ── Logo band ────────────────────────────────────────────────────────
     The surface flip itself is the shared `.band` machinery in tokens.css.
     What is local here is the logo colour: the marks go pure white on the
     dark surface rather than the pale-mint --text, so they read as brand
     marks and not as body copy. */
  .logo-band {
    padding: 80px 0;
  }
  .logo-band .tool {
    color: #fff;
    transition: color 400ms ease;
  }
  .logo-band.is-light .tool {
    color: #4a5856;
  }

  /* ── Testimonials + footer band ─────────────────────────────────────
     No `background` here: the `.band` ::before layer paints it, so the
     dark→light change can fade. Setting a background on the section itself
     would cover that layer and snap. */
  .light {
    padding: 88px 0 30px;
    color: var(--text);
  }

  .light__title {
    margin: 0 auto 35px;
    text-align: center;
    color: var(--muted);
  }

  /* Matches the nav hairline (--nav-border, 1px) rather than the heavier
     --rule, so it whispers the section break instead of drawing a hard line. */
  .rule {
    height: 1px;
    margin: 95px auto 0;
    border: 0;
    background: var(--nav-border);
  }

  /* ── Responsive ─────────────────────────────────────────────────────
     No mobile frames exist in the Figma file, so everything below this line
     is invented. It stacks the 962px container and keeps the reading order;
     Victor should review it against real devices. */
  @media (max-width: 1000px) {
    .hero__row {
      flex-direction: column;
      gap: 32px;
    }
    .hero__row > :global(.slider) {
      width: 100%;
      margin-top: 0;
    }
    .hero__row > :global(.reel) {
      margin-top: 0;
    }
    .video {
      height: auto;
      aspect-ratio: 473 / 522;
    }
    .kpis {
      grid-template-columns: 1fr;
    }
    .approach {
      gap: 72px;
      /* Same 72/72 split as desktop: lead-in above the statement, and the
         gap below the KPIs, both inside the band's own box. */
      margin-top: 22px;
      padding-top: 50px;
      padding-bottom: 72px;
    }
    .logo-band {
      padding: 56px 0;
    }
    .light {
      padding-top: 64px;
    }
    .rule {
      margin-top: 56px;
    }
  }

  @media (max-width: 720px) {
    .hero__top {
      flex-direction: column;
      gap: 20px;
    }
    .hero__title {
      max-width: none;
    }
  }
</style>
