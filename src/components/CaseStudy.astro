---
import Nav from "./Nav.astro";
import SiteFooter from "./SiteFooter.astro";
import ProjectSlider, { type Slide } from "./ProjectSlider.astro";
import { getProjects } from "../data/projects";
import { getCase } from "../data/cases";
import { withBase } from "../lib/base";
import { getLangFromUrl, homePath, projectsPath, projectPath } from "../i18n";
import { useTranslations } from "../i18n/ui";

export type { Block, Bullet, Shot } from "../data/cases";

/**
 * Shared case-study layout, reconstructed from the Figma frames (page 3.0):
 * Polestar `964:996` and LeanCore Studio `971:1009`. Same skeleton as the
 * hand-built Coca-Cola page — dark hero, a wider #212626 two-column body
 * (450px editorial copy + 678px screenshot stack), the light "next projects"
 * band, and the shared footer — but driven by data so both pages share it.
 *
 * Every string comes from `src/data/cases.ts`, resolved for the locale of the
 * URL being rendered. Nothing user facing is typed into this file, which is
 * what keeps the Spanish and English versions from drifting apart.
 *
 * The right-column screenshots stay as exported images: they are the clients'
 * live products (a Pilates site, a fintech flow-builder), so rebuilding them in
 * HTML would be reconstructing someone else's product, not Victor's design.
 *
 * A shot is a screenshot, or an animated WebP — both render as a plain `<img>`.
 * `half: true` makes it a half-width tile; two consecutive halves sit
 * side-by-side in one grid row. Everything else spans full width. `bed: true`
 * gives the tile a light backing instead of the dark surface, for stills whose
 * own background is light.
 *
 * There is deliberately no `<video>` branch. The one clip on these pages was an
 * autoplaying muted loop and it cost days: it played in every environment I
 * could test and never for Victor, across autoplay policy, media decode,
 * extensions and cache revalidation, none of which are observable from here. An
 * animated WebP has none of those failure modes — no play() to reject, no
 * decoder, nothing an extension or an energy saver can pause. If you need real
 * video here again (sound, controls, minutes of footage) bring the element
 * back; for a short silent UI loop, do not.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const study = getCase(slug, lang);

// Same related-projects slider the Coca-Cola page uses.
const slides: Slide[] = getProjects(lang).map((p) => ({
  title: p.title,
  img: p.img,
  alt: p.alt,
  tags: p.cardTags ?? p.tags,
  desc: p.desc,
  href: withBase(projectPath(p.slug, lang)),
  placeholder: p.placeholder,
}));
---

<Nav wide />

<main>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero container-wide">
    <div class="hero__grid">
      <div class="hero__left">
        <a class="back" href={withBase(homePath[lang])}>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M14 5 7.5 12l6.5 7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          {t("case.back")}
        </a>

        {/* El showreel se quitó (2026-08-19) pero reservamos su hueco exacto
            para que el resto del hero y el body de abajo no se muevan. */}
        <div class="hero__space" aria-hidden="true"></div>
      </div>

      <div class="hero__body">
        <h1 class="t-h2 hero__title">
          {
            study.mutedLead ? (
              <>
                <span class="muted">{study.headline.muted}</span> {study.headline.base}
              </>
            ) : (
              <>
                {study.headline.base} <span class="muted">{study.headline.muted}</span>
              </>
            )
          }
        </h1>

        <ul class="tags">
          {study.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>

        <p class="hero__desc">{study.intro}</p>

        <p class="hero__meta">
          <span>{study.meta.year}</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{t("case.launchedBy")} {study.meta.client}</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ── Case body ────────────────────────────────────────────────────── -->
  <section class="case">
    <div class="case__grid container-wide">
      <div class="case__copy">
        {
          study.blocks.map((block) => (
            <section class="block">
              <h2 class="block__heading">{block.heading}</h2>
              {block.lead && <p class="block__lead">{block.lead}</p>}
              {block.paras?.map((para) => <p class="block__para">{para}</p>)}
              {block.bullets && (
                <ul class="block__bullets">
                  {block.bullets.map((b) => (
                    <li>
                      {b.term ? (
                        <>
                          <strong>{b.term}</strong> {b.body}
                        </>
                      ) : (
                        b.body
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <div class="case__shots">
        {
          study.shots.map((shot, i) => (
            <figure class:list={["shot", shot.half && "shot--half", shot.bed && "shot--bed"]}>
              <img
                src={shot.src}
                alt={shot.alt}
                width={shot.w}
                height={shot.h}
                loading={i === 0 ? "eager" : "lazy"}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Related projects ─────────────────────────────────────────────── -->
  <section class="related">
    <div class="related__grid container">
      <div class="related__intro">
        <h2 class="t-h2 related__title">{t("case.related.title")}</h2>
        <p class="related__desc">{t("case.related.desc")}</p>
        <a class="related__cta" href={withBase(projectsPath[lang])}>
          {t("case.related.cta")}
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>

      <ProjectSlider slides={slides} />
    </div>
  </section>

  <!-- ── Light footer band ────────────────────────────────────────────── -->
  {/* id="resumen" queda por inercia (la banda clara de testimonios/footer);
      el nav ya no ancla aquí — "Resumen" descarga /resumen.pdf. */}
  <section class="light theme-light" data-theme-light id="resumen">
    <hr class="rule container" />
    <SiteFooter home={false} />
  </section>
</main>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────────
     Without the showreel (removed 2026-08-19) the hero is Volver on its
     own line and the title/intro block below it at a comfortable measure. */
  .hero {
    padding-top: 14px;
  }
  .hero__grid {
    display: grid;
    /* La columna izquierda conserva el ancho del reel aunque ya no haya video:
       la loseta-reserva mantiene el ritmo vertical del frame. */
    grid-template-columns: 291px minmax(0, 1fr);
    gap: 71px;
    align-items: start;
  }
  .hero__left {
    display: flex;
    flex-direction: column;
  }
  /* Hueco que ocupaba el showreel (quitado 2026-08-19): solo dimensiones,
     vacío de verdad, para que nada debajo se desplace. */
  .hero__space {
    margin-top: 25px;
    width: 291px;
    height: 358px;
    flex: none;
  }
  .hero__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    height: 24px;
    font-size: 18px;
    line-height: 22.7px;
    font-weight: 300;
    color: var(--text);
    transition: opacity 200ms ease;
  }
  .back svg {
    width: 20px;
    height: 20px;
    transition: translate 200ms ease;
  }
  .back:hover {
    opacity: 0.75;
  }
  .back:hover svg {
    translate: -3px 0;
  }

  .hero__title {
    margin: 0;
    color: var(--text);
  }
  .muted {
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tag {
    padding: 6px 8px;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    color: var(--accent);
    font-size: 12px;
    line-height: 10px;
    font-weight: 500;
  }

  .hero__desc {
    margin: 0;
    font-size: 18px;
    line-height: 22.7px;
    font-weight: 300;
    color: var(--text);
  }
  .hero__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
  }
  .hero__meta .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* ── Case body ────────────────────────────────────────────────────────
     Full-bleed #212626 band; copy column 450px, shots 678px, 61px gutter. */
  .case {
    margin-top: 36px;
    padding: 83px 0 126px;
    background: var(--surface-alt);
  }
  .case__grid {
    display: grid;
    grid-template-columns: 450px 678px;
    gap: 61px;
    align-items: start;
  }
  .case__copy {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .block__heading {
    margin: 0;
    font-size: 20px;
    line-height: 30px;
    font-weight: 400;
    color: var(--muted);
  }
  .block__lead {
    margin: 0;
    font-size: 25px;
    line-height: 30px;
    font-weight: 400;
    color: var(--text);
  }
  .block__para {
    margin: 0;
    white-space: pre-line;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
  }

  /* Bulleted points: a bold lead-in term, a lime dash marker at the column
     edge (the Figma frames use a "-" dash, not the Coca-Cola pushpin). */
  .block__bullets {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .block__bullets li {
    position: relative;
    padding-left: 20px;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
  }
  .block__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 9px;
    width: 9px;
    height: 1.5px;
    background: var(--accent);
  }
  .block__bullets strong {
    font-weight: 600;
  }

  /* Screenshot grid — two columns, 34px gaps. Shots span the full width by
     default (a vertical stack, unchanged for the other case studies); a pair
     of `.shot--half` tiles shares one row (used by the LeanCore-web grid where
     the roadmap video sits beside a phone mock). */
  .case__shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 34px;
    align-items: start;
  }
  .shot {
    grid-column: 1 / -1;
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }
  .shot--half {
    grid-column: span 1;
    /* Square tile so the two row-mates line up; the roadmap loop is pre-cropped
       to 1:1 (card only, no letterbox) and the phone is object-fit cropped. */
    aspect-ratio: 1 / 1;
  }
  .shot img {
    width: 100%;
    height: auto;
    display: block;
  }
  .shot--half img {
    height: 100%;
    object-fit: cover;
  }
  /* For stills whose own background is light — give the tile a matching bed so
     any sub-pixel gap reads light, not the dark surface. */
  .shot--bed {
    background: #e0e0e0;
  }

  /* ── Related projects ─────────────────────────────────────────────── */
  .related {
    padding-top: 100px;
    padding-bottom: 100px;
  }
  .related__grid {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 130px;
  }
  .related__intro {
    width: 369px;
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 71px;
  }
  .related__title {
    margin: 0;
    max-width: 345px;
    color: var(--muted);
  }
  .related__desc {
    margin: 0;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--muted);
  }
  .related__cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 5px;
    padding: 9px 10px;
    border-radius: var(--r-sm);
    background: var(--accent);
    color: #1d2222;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 400;
  }
  .related__cta svg {
    width: 18px;
    height: 18px;
    transition: translate 250ms ease;
  }
  .related__cta:hover svg {
    translate: 4px -4px;
  }

  /* ── Light footer band ────────────────────────────────────────────── */
  .light {
    background: var(--bg);
    color: var(--text);
    padding-bottom: 30px;
  }
  .rule {
    height: 1px;
    margin: 0 auto;
    border: 0;
    background: var(--nav-border);
  }

  /* ── Responsive (invented — no mobile frames exist; needs review) ───── */
  @media (max-width: 1240px) {
    .case__grid {
      grid-template-columns: minmax(0, 450px) minmax(0, 678px);
      gap: 40px;
    }
  }
  @media (max-width: 620px) {
    /* Phones: stack every tile full-width; the half tiles drop their square
       crop and show at natural size. */
    .case__shots {
      grid-template-columns: 1fr;
    }
    .shot--half {
      grid-column: 1 / -1;
      aspect-ratio: auto;
    }
    .shot--half img,
    .shot--half video {
      height: auto;
      object-fit: fill;
    }
  }
  @media (max-width: 1000px) {
    .hero__grid,
    .case__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .case {
      padding: 56px 0 64px;
    }
    .related {
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .related__grid {
      flex-direction: column;
      gap: 40px;
    }
    .related__intro {
      width: 100%;
      margin-top: 0;
    }
  }
</style>
