---
import QuoteOpen from "../icons/quote-open.svg?raw";
import QuoteClose from "../icons/quote-close.svg?raw";
import { testimonials, defaultTestimonial } from "../data/testimonials";

/**
 * Figma Component 24 (959x536) — the quote card plus the 7-avatar picker.
 *
 * Clicking an avatar swaps the quote. The selected tile lifts 10px and goes to
 * full opacity, and gets 73px of breathing room either side (Figma x-positions
 * 297/382/467 · 607 · 747/832/917) so the name/role/button block below has room.
 */
---

<figure class="quote container" data-testimonials>
  <blockquote class="quote__card">
    <span class="quote__mark" aria-hidden="true" set:html={QuoteOpen} />
    {/* Every quote is rendered, all in the SAME grid cell. The card is
        therefore always as tall as the longest one, so switching testimonials
        cannot resize it and nothing below it jumps. Rendering only the active
        quote is what caused that: five of the six sit at 322px and Alejandro's
        four-paragraph one at 442px, a 120px jolt on every swap. */}
    <div class="quote__stack" data-quote-stack aria-live="polite">
      {
        testimonials.map((person, i) => (
          <div
            class:list={["quote__text", "t-lead", i === defaultTestimonial && "is-on"]}
            data-quote
            aria-hidden={i === defaultTestimonial ? undefined : "true"}
          >
            {person.quote.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        ))
      }
    </div>
    <span class="quote__mark quote__mark--close" aria-hidden="true" set:html={QuoteClose} />
  </blockquote>

  <figcaption class="people">
    <ul class="people__row" role="tablist" aria-label="Testimonios">
      {
        testimonials.map((person, i) => (
          <li class="person">
            <button
              class:list={["avatar", i === defaultTestimonial && "avatar--active"]}
              type="button"
              role="tab"
              data-person
              aria-selected={i === defaultTestimonial ? "true" : "false"}
              aria-label={person.placeholder ? `Testimonio ${i + 1}` : person.name}
            >
              <img src={person.avatar} alt="" width="47" height="47" loading="lazy" />
            </button>
            {/* Name, role and profile link all ride under their own avatar; only
                the active one shows (CSS adjacent-sibling + visibility), so no JS
                swap is needed. */}
            <div class="person__detail">
              <span class="person__name">{person.name}</span>
              <span class="person__role">{person.role}</span>
              <a class="person__link" href={person.profileUrl}>
                Ir a su perfil
                <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </figcaption>
</figure>

<script>
  import { defaultTestimonial } from "../data/testimonials";

  function boot() {
  const root = document.querySelector<HTMLElement>("[data-testimonials]");
  if (root && !root.dataset.ready) {
    root.dataset.ready = "1";
    const quotes = [...root.querySelectorAll<HTMLElement>("[data-quote]")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-person]")];
    let index = defaultTestimonial;

    function select(next: number) {
      if (next === index) return;
      index = next;

      // Every quote is already in the DOM, so this is a cross-fade between two
      // stacked elements rather than a text replacement. The card cannot
      // change height, so nothing below it moves.
      quotes.forEach((q, i) => {
        const on = i === index;
        q.classList.toggle("is-on", on);
        if (on) q.removeAttribute("aria-hidden");
        else q.setAttribute("aria-hidden", "true");
      });

      buttons.forEach((b, i) => {
        b.setAttribute("aria-selected", String(i === index));
        b.classList.toggle("avatar--active", i === index);
      });
    }

    buttons.forEach((b, i) => b.addEventListener("click", () => select(i)));

    // Left/right arrows move between avatars, per the tablist pattern.
    root.querySelector("[role=tablist]")?.addEventListener("keydown", (e) => {
      const key = (e as KeyboardEvent).key;
      if (key !== "ArrowLeft" && key !== "ArrowRight") return;
      e.preventDefault();
      const next = (index + (key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length;
      select(next);
      buttons[next].focus();
    });
  }
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .quote {
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    /* Figma's 40px gap is measured to the *lifted* active avatar; our lift is a
       transform (no layout effect), so the layout gap is 40+10. */
    gap: 50px;
    align-items: center;
  }

  /* Figma lays this out SPACE_BETWEEN at a fixed 322px, which distributes the
     slack between the quote marks and the text rather than using a set gap. */
  .quote__card {
    position: relative;
    width: 100%;
    min-height: 322px;
    margin: 0;
    padding: 25px;
    background: var(--surface);
    border-radius: var(--r-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 10px;
  }

  /* IcomoonFreeQuotes glyphs — rounded blobs, not typographic quote marks.
     The SVGs carry their own 0.6 opacity from the Figma frames. */
  .quote__mark {
    width: 30px;
    height: 30px;
    color: var(--muted);
  }
  .quote__mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .quote__mark--close {
    align-self: flex-end;
  }

  /* One cell, every quote in it. The grid takes the height of its tallest
     child whether or not that child is the visible one, which is exactly the
     fixed height we want — and it stays correct if a quote is edited, with no
     hard-coded number to keep in sync. `visibility` rather than `display` is
     load-bearing: a hidden child still has to occupy the cell to hold the
     height open. */
  .quote__stack {
    display: grid;
    width: 100%;
    max-width: 757px;
    margin-inline: auto;
  }

  .quote__text {
    grid-area: 1 / 1;
    /* The cell is as tall as the LONGEST quote, so short ones must centre in
       it or they hang off the top with dead space under them. */
    align-self: center;
    text-align: center;
    color: var(--muted);
    opacity: 0;
    visibility: hidden;
    translate: 0 6px;
    /* Delay visibility to the end of the fade going out, and apply it
       immediately coming in, so the outgoing quote is never clickable/readable
       while it is still fading. */
    transition:
      opacity 300ms ease,
      translate 300ms ease,
      visibility 0s 300ms;
  }
  .quote__text.is-on {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition:
      opacity 300ms ease,
      translate 300ms ease,
      visibility 0s;
  }
  .quote__text :global(p) {
    margin: 0;
  }
  .quote__text :global(p + p) {
    margin-top: 1em;
  }

  .people {
    position: relative;
    width: 687px;
    max-width: 100%;
    /* Reserve room for the name/role/button group that sits absolutely
       positioned under the active avatar. */
    padding-bottom: 118px;
  }

  .people__row {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each tile owns the space under it so its name can sit there without
     shifting the row. */
  .person {
    position: relative;
    display: flex;
    justify-content: center;
  }

  /* Name + role + profile button all stack directly under the active avatar,
     centered on the tile so they follow the selection. Only the active tile's
     group shows (adjacent sibling + visibility for a11y/tab order). */
  .person__detail {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    translate: -50% 6px;
    width: max-content;
    max-width: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: var(--muted);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 300ms ease,
      translate 300ms ease,
      visibility 0s 300ms;
  }
  .avatar--active + .person__detail {
    opacity: 1;
    visibility: visible;
    translate: -50% 0;
    pointer-events: auto;
    transition:
      opacity 300ms ease,
      translate 300ms ease,
      visibility 0s;
  }

  .person__name {
    font-size: 16px;
    line-height: 18px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
  }
  .person__role {
    margin-top: 2px;
    font-size: 16px;
    line-height: 18px;
    font-weight: 300;
  }
  .person__link {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    margin-top: 16px;
    padding: 9px 10px;
    border-radius: var(--r-sm);
    background: var(--accent);
    color: #4a5856;
    font-size: 16px;
    line-height: 20.2px;
    white-space: nowrap;
    overflow: hidden;
  }
  .person__link svg {
    width: 18px;
    height: 18px;
    transition: translate 250ms ease;
  }
  .person__link:hover svg {
    translate: 4px -4px;
  }

  /* 67px tiles with a squircle that squares off at the bottom-left. */
  /* Loseta-marco estilo showcase: borde alrededor (como el Nav) y la foto
     circular dentro, donde el borde asoma por el hueco entre marco y círculo. */
  .avatar {
    width: 67px;
    height: 67px;
    padding: 0;
    border: 1px solid var(--nav-border);
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border-radius: 20px 20px 20px 0;
    opacity: 0.6;
    cursor: pointer;
    transition:
      opacity 320ms ease,
      translate 320ms ease,
      margin 380ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .avatar img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
  }
  .avatar:hover,
  .avatar:focus-visible {
    opacity: 1;
  }
  .avatar--active {
    opacity: 1;
    translate: 0 -10px;
    /* 73px flanking the selected tile vs 18px elsewhere: 55px extra each side. */
    margin-inline: 55px;
  }

  @media (max-width: 1000px) {
    .people {
      width: 100%;
    }
  }

  /* Phones: keep all seven avatars on ONE row (shrunk) instead of wrapping, and
     center the active name/role/button group under the whole row rather than
     under its tile — under an edge tile it would run off the screen. */
  @media (max-width: 620px) {
    .people {
      padding-bottom: 128px;
    }
    .people__row {
      position: relative;
      flex-wrap: nowrap;
      gap: 7px;
    }
    .avatar {
      width: 40px;
      height: 40px;
      border: 1px solid var(--nav-border);
      border-radius: 13px 13px 13px 0;
    }
    .avatar img {
      width: 30px;
      height: 30px;
      border-radius: 50%;
    }
    .avatar--active {
      margin-inline: 12px;
    }
    /* Detail is measured against the row (centered), not the tile. */
    .person {
      position: static;
    }
    .person__detail {
      top: calc(100% + 16px);
      max-width: 92vw;
    }
  }
</style>
