---
import LogoFlip from "./LogoFlip.astro";

/**
 * Entry loading screen (harrygeorge.design / ampli.net / juanmora.co).
 *
 * Not in the Figma file — built from Victor's palette: the dark surface, the
 * lime accent for the progress rule, and the same word-flip logo as the nav.
 *
 * Shows once per session. Subsequent navigations use the page transition
 * instead, so returning to Home doesn't replay the whole intro.
 */
---

<div class="preloader" data-preloader aria-hidden="true">
  <div class="preloader__inner">
    <LogoFlip scale={1.6} href="#" label="Victor Vivas" />
    <div class="preloader__meter">
      <span class="preloader__bar" data-preloader-bar></span>
    </div>
    <span class="preloader__count" data-preloader-count>0</span>
  </div>
</div>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background: #1d2222;
    /* Clip-path wipe rather than a fade — the page underneath is already
       painted, so a wipe reveals it instead of cross-dissolving to it. */
    clip-path: inset(0 0 0 0);
    transition: clip-path 900ms cubic-bezier(0.76, 0, 0.24, 1);
    /* Pure-CSS failsafe: if the script never runs at all (JS disabled, a module
       that failed to load), the overlay still gets out of the way instead of
       covering the site permanently. */
    animation: preloader-failsafe 1ms linear 4s forwards;
  }

  @keyframes preloader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  .preloader.is-done {
    clip-path: inset(0 0 100% 0);
    pointer-events: none;
  }

  .preloader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    transition:
      opacity 400ms ease,
      translate 600ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .preloader.is-done .preloader__inner {
    opacity: 0;
    translate: 0 -16px;
  }

  .preloader__meter {
    width: 220px;
    height: 2px;
    background: #2a3231;
    overflow: hidden;
  }

  .preloader__bar {
    display: block;
    width: 0%;
    height: 100%;
    background: #dbe976;
    transition: width 260ms cubic-bezier(0.3, 0, 0.2, 1);
  }

  .preloader__count {
    color: #4a5856;
    font-size: 16px;
    line-height: 18px;
    font-weight: 300;
    font-variant-numeric: tabular-nums;
  }
  .preloader__count::after {
    content: "%";
  }

  /* The logo shouldn't be a live link on the splash. */
  .preloader :global(.logo) {
    pointer-events: none;
  }

  /* No splash at all if the user has asked for less motion — it's pure
     decoration and it delays content. */
  @media (prefers-reduced-motion: reduce) {
    .preloader {
      display: none;
    }
  }
</style>

<script>
  // A splash that can get stuck is worse than no splash: it covers the page at
  // z-index 1000 and locks scrolling, so a single thrown error takes the whole
  // site down. Everything below is written so the overlay ALWAYS goes away.
  const el = document.querySelector<HTMLElement>("[data-preloader]");
  const bar = document.querySelector<HTMLElement>("[data-preloader-bar]");
  const count = document.querySelector<HTMLElement>("[data-preloader-count]");

  const DURATION = 1100; // how long the intro runs at most, in ms
  const SEEN = "vv:intro-seen";

  let finished = false;
  function finish(immediate = false) {
    if (finished) return;
    finished = true;
    document.documentElement.classList.remove("is-loading");
    if (!el) return;
    if (immediate) {
      el.remove();
      return;
    }
    el.classList.add("is-done");
    el.addEventListener("transitionend", () => el.remove(), { once: true });
    // If the transition never fires (reduced motion, interrupted), still clean up.
    window.setTimeout(() => el.remove(), 1200);
  }

  if (el) {
    // Absolute backstop, registered FIRST so it survives anything below throwing.
    window.setTimeout(() => finish(), 3000);

    try {
      // sessionStorage throws outright when storage is blocked (some privacy
      // modes, embedded webviews). Treat that as "not seen" rather than letting
      // it kill the script and strand the overlay.
      let seen = false;
      try {
        seen = !!sessionStorage.getItem(SEEN);
        sessionStorage.setItem(SEEN, "1");
      } catch {
        /* storage unavailable — show the intro, just don't remember it */
      }

      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (reduced || seen) {
        finish(true);
      } else {
        document.documentElement.classList.add("is-loading");

        const paint = (pct: number) => {
          const v = Math.max(0, Math.min(100, Math.round(pct)));
          if (bar) bar.style.width = `${v}%`;
          if (count) count.textContent = String(v);
        };

        // The counter is driven by the clock, not by asset events. Assets only
        // let it finish EARLY — they can never hold it back. A lazy-loaded
        // image below the fold never fires `load` while scrolling is locked,
        // which is exactly the kind of stall that used to wedge this.
        const started = performance.now();
        let assetRatio = 0;

        const media = [...document.images, ...document.querySelectorAll("video")];
        const total = media.length || 1;
        let done = 0;
        const bump = () => {
          done++;
          assetRatio = done / total;
        };
        for (const m of media) {
          const node = m as HTMLImageElement & HTMLVideoElement;
          // Videos with preload="metadata" may never reach readyState 3, so
          // metadata alone counts as loaded for progress purposes.
          if (node.complete || node.readyState >= 1) bump();
          else {
            node.addEventListener("load", bump, { once: true });
            node.addEventListener("loadedmetadata", bump, { once: true });
            node.addEventListener("error", bump, { once: true });
          }
        }

        const frame = () => {
          if (finished) return;
          const elapsed = performance.now() - started;
          const byTime = elapsed / DURATION;
          // Whichever is further along wins, so a warm cache finishes fast and
          // a cold one still reaches 100 by DURATION.
          const pct = Math.min(1, Math.max(byTime, assetRatio * 0.9)) * 100;
          paint(pct);
          if (pct >= 100) {
            // Hold at 100 briefly — snapping away instantly reads as a flicker.
            window.setTimeout(() => finish(), 260);
            return;
          }
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    } catch {
      // Anything unexpected: drop the overlay rather than trap the page.
      finish(true);
    }
  } else {
    document.documentElement.classList.remove("is-loading");
  }
</script>
