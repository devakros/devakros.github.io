---
import LogoFlip from "./LogoFlip.astro";
import { withBase } from "../lib/base";

/**
 * Figma `menu dark version` (1007:5859) — 962x66, #1A1E1E on a 1px #2A3231
 * hairline, 10px radius, sits at y=34 and sticks there.
 *
 * `menu light version` (942:72, #F6F6F6) is the same component re-themed. It
 * exists for exactly one reason: the nav crosses the light band that starts at
 * y=2036, so it inverts on scroll rather than being a user-facing toggle.
 */
interface Props {
  /** Case-study pages use the wider body container so the nav's left/right
      edges line up with the copy + screenshots below it. */
  wide?: boolean;
}
const { wide = false } = Astro.props;

// Only Home carries #sobre-mi, so off Home that link has to go back to Home
// first — otherwise it sets the hash and nothing happens. Every page has a
// #resumen (the light testimonials/footer band), so that one stays in-page.
// "Proyectos" now goes to the /proyectos index rather than Home's slider
// anchor: it is a real page, and the anchor only existed on Home anyway.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const onHome = Astro.url.pathname.replace(/\/$/, "") === BASE;

const links = [
  { label: "Proyectos", href: withBase("/proyectos") },
  { label: "Sobre mi", href: onHome ? "#sobre-mi" : withBase("/#sobre-mi") },
  { label: "Resumen", href: "#resumen" },
];
---

<header class:list={["nav", wide ? "container-wide" : "container"]} data-nav data-intro-hide>
    <LogoFlip scale={1} />

    <nav class="nav__right" aria-label="Principal">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true" />}
            {/* Per-character roll (marrow.au): each letter is a clipped window
                holding the letter twice, stacked. On hover they slide up in
                sequence. The visible copy is aria-hidden and the accessible
                name comes from the sr-only span. */}
            <a class="nav__link" href={link.href} style={`--ni:${i}`}>
              <span class="sr-only">{link.label}</span>
              <span class="roll" aria-hidden="true">
                {[...link.label].map((ch, c) => (
                  <span class="roll__char" style={`--i:${c}`}>
                    <span class="roll__inner">
                      <span class="roll__face">{ch === " " ? " " : ch}</span>
                      <span class="roll__face">{ch === " " ? " " : ch}</span>
                    </span>
                  </span>
                ))}
              </span>
            </a>
          </>
        ))
      }
      {/* Below 720px the three links above are hidden and this replaces them.
          Two bars rather than the usual three: the logo mark is already two
          stacked words, so two reads as part of the same system. */}
      <button
        class="nav__burger"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Abrir menú"
      >
        <span class="nav__burger-box" aria-hidden="true"><span /><span /></span>
      </button>

      <a class="nav__cta" href="#contacto" data-contact-open>¡Hablemos!</a>
    </nav>

    {/* Drops out of the nav pill itself rather than covering the screen — the
        menu is three links, and a full-screen takeover for three links is
        theatre. Inherits --nav-bg/--text so it re-themes with the pill when the
        scroll bands flip to light. */}
    <div class="nav__menu" id="nav-menu" data-nav-menu hidden>
      {
        links.map((link) => (
          <a class="nav__menu-link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </div>
</header>

<style>
  /* A sticky element only travels within its containing block. Wrapping the
     nav in a 100px-tall div meant it stuck for 100px and then scrolled away
     with the wrapper — so the nav is a direct child of <body> instead, whose
     box spans the whole page.
     `margin-top` (not the wrapper's padding) supplies the 34px offset: the
     natural position and the sticky `top` then agree, so nothing shifts at
     scroll 0. body has `display: flow-root` to stop that margin collapsing. */
  .nav {
    position: sticky;
    top: 34px;
    z-index: 100;
    margin-top: 34px;
    margin-bottom: 29px; /* hero row starts at y=129; nav bottom is y=100 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
    padding: 10px 13px 10px 20px;
    background: var(--nav-bg);
    border: 1px solid var(--nav-border);
    border-radius: var(--r-md);
    transition:
      background-color 400ms ease,
      border-color 400ms ease,
      color 400ms ease;
  }

  /* Applied by the scroll observer once the nav overlaps the light band.
     Redefining the tokens locally means LogoFlip and the links re-theme
     without knowing anything about the flip. */
  .nav.is-light {
    --nav-bg: #f6f6f6;
    --nav-border: #e2e5e4;
    --text: #4a5856;
    --muted: #9aa5a3;
    --on-accent: #4a5856;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Entrance stagger. The bar itself slides down (tokens.css); once it lands,
     the logo, links and CTA settle in one after another. `both` fill holds each
     item at its from-state through its delay, so nothing flashes early. Gated
     on .did-intro — added by the intro script only on the real first-load
     sequence — so client-side navigations don't replay it. */
  .nav.did-intro :is(.logo, .nav__link, .nav__cta) {
    animation: nav-item-in 540ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .nav.did-intro .logo {
    animation-delay: 150ms;
  }
  .nav.did-intro .nav__link {
    animation-delay: calc(220ms + var(--ni, 0) * 70ms);
  }
  .nav.did-intro .nav__cta {
    animation-delay: 450ms;
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      translate: 0 -7px;
    }
  }

  .nav__link {
    padding: 9px 10px;
    border-radius: var(--r-sm);
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* --- Per-character roll ------------------------------------------------ */
  .roll {
    display: inline-flex;
  }

  .roll__char {
    display: inline-block;
    height: 20.2px; /* the link's line-height — the clip window */
    overflow: hidden;
  }

  .roll__inner {
    display: block;
    transition: transform 420ms cubic-bezier(0.76, 0, 0.24, 1);
    /* Stagger left-to-right; 22ms per character reads as one wave, not
       seven separate animations. */
    transition-delay: calc(var(--i) * 22ms);
  }

  .roll__face {
    display: block;
    height: 20.2px;
    line-height: 20.2px;
    white-space: pre;
  }

  .nav__link:hover .roll__inner,
  .nav__link:focus-visible .roll__inner {
    transform: translateY(-20.2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .roll__inner {
      transition: none;
    }
    .nav__link:hover .roll__inner,
    .nav__link:focus-visible .roll__inner {
      transform: none;
    }
    .nav.did-intro :is(.logo, .nav__link, .nav__cta) {
      animation: none;
    }
  }

  .sep {
    width: 1px;
    height: 12px;
    background: var(--muted);
    flex: none;
  }

  .nav__cta {
    padding: 9px 10px;
    border-radius: var(--r-sm);
    background: var(--accent);
    color: #1d2222;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 400;
    transition: filter 200ms ease;
  }

  .nav__cta:hover,
  .nav__cta:focus-visible {
    filter: brightness(1.08);
  }

  /* ── Mobile menu ──────────────────────────────────────────────────────
     The burger and its panel only exist below 720px, where the inline links
     are hidden. Before this the bar offered no navigation at all on a phone —
     only ¡Hablemos! — and the three links lived solely in the footer. */
  .nav__burger {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .nav__burger-box {
    display: grid;
    gap: 5px;
    width: 20px;
  }
  .nav__burger-box span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 160ms ease;
  }
  /* Two bars cross into an X. translateY is half the 5px gap plus the 2px bar,
     so they meet exactly on the centre line. */
  .nav__burger[aria-expanded="true"] .nav__burger-box span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] .nav__burger-box span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 8px;
    border: 1px solid var(--nav-border);
    border-radius: var(--r-md);
    background: var(--nav-bg);
    /* The pill is z-index 100 and this hangs below it; lift it over the grain
       (90) and page content the same way. */
    z-index: 1;
    opacity: 0;
    translate: 0 -8px;
    transition:
      opacity 220ms ease,
      translate 260ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav__menu[hidden] {
    display: none;
  }
  .nav__menu.is-open {
    opacity: 1;
    translate: 0 0;
  }

  .nav__menu-link {
    padding: 14px 12px;
    border-radius: var(--r-sm);
    color: var(--text);
    font-size: 17px;
    line-height: 22px;
    font-weight: 300;
    transition: background-color 200ms ease;
  }
  .nav__menu-link:hover,
  .nav__menu-link:focus-visible {
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__menu,
    .nav__burger-box span {
      transition: none;
    }
  }

  @media (max-width: 720px) {
    .nav {
      padding: 10px 12px;
      height: 58px;
    }
    /* The three text links collapse into the burger menu below. */
    .nav__link,
    .sep {
      display: none;
    }
    .nav__burger {
      display: grid;
    }
  }

  /* Above the breakpoint the inline links are back, so the panel must never
     appear — including if a resize happens while it is open. */
  @media (min-width: 721px) {
    .nav__menu {
      display: none;
    }
  }
</style>

<script>
  // Everything re-themes against one horizontal line at y=217 (the nav's own
  // vertical centre once it has stuck). Two mechanisms feed it:
  //
  //  · [data-band] — Home's three surfaces: the statement/KPI block, the logo
  //    wall, and the testimonials/footer block. They all flip TOGETHER, and
  //    ONE element decides when: the logo wall, marked [data-band-trigger].
  //    The whole screen is meant to toggle as the brand logos reach the line —
  //    per Victor the change belongs at the logos and nowhere else, so do not
  //    give the other two bands their own trigger. Measuring each band against
  //    the line individually is the obvious implementation and it is wrong: it
  //    staggers the change into three separate events down the page.
  //
  //    The test is position-only (top ≤ line), so the bands stay light once the
  //    wall has scrolled up and off; a straddle test would flip them back to
  //    dark while the wall is still on screen, which flashes black. It reverses
  //    on the way back up — the bands toggle both ways.
  //  · [data-theme-light] — the case-study footers, which are permanently
  //    light and never flip. They only need to tell the nav to invert, so
  //    they keep the straddle observer.
  //
  // The nav follows whatever surface is under the line: light once the bands
  // have flipped, or while a static light section straddles it.
  const SWITCH = 217;
  // Dead zone below the line. Without it a trackpad resting on the boundary
  // re-triggers the 400ms fade every frame and the band strobes.
  const HYSTERESIS = 20;

  let observer: IntersectionObserver | undefined;
  let onScroll: (() => void) | undefined;
  let raf = 0;

  // ── Mobile menu ────────────────────────────────────────────────────────
  // Closes the panel from anywhere. Kept at module scope because the document
  // level listeners below are bound ONCE, while the panel itself is a new
  // element after every client-side navigation.
  let closeMenu: (() => void) | undefined;
  let docBound = false;

  function bootMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
    if (!toggle || !menu) return;
    // bootMenu runs at module scope AND on astro:page-load, which both fire on
    // the initial load. Without this the toggle collects two click listeners
    // and every tap opens then instantly closes the panel — it looked like the
    // button did nothing at all.
    if (toggle.dataset.ready) return;
    toggle.dataset.ready = "1";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      if (open) {
        menu.hidden = false;
        // One frame between unhiding and the class, or the transition has no
        // start value to animate from. Same reason ContactDrawer does it.
        requestAnimationFrame(() => menu.classList.add("is-open"));
      } else {
        menu.classList.remove("is-open");
        // Wait out the fade before hiding, unless motion is reduced.
        const done = () => (menu.hidden = true);
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) done();
        else window.setTimeout(done, 220);
      }
    };

    closeMenu = () => {
      if (toggle.getAttribute("aria-expanded") === "true") setOpen(false);
    };

    // Bound to the fresh elements each swap, so these die with the old DOM.
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    menu.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) closeMenu?.();
    });

    if (docBound) return;
    docBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeMenu?.();
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Element;
      // Anything outside the nav closes it; the toggle handles itself above.
      if (!t.closest?.("[data-nav-menu], [data-nav-toggle]")) closeMenu?.();
    });
    // A resize past the breakpoint hides the panel via CSS, so its state has
    // to be reset or the burger comes back reading "expanded".
    window.addEventListener("resize", () => {
      if (window.innerWidth > 720) closeMenu?.();
    });
  }

  function boot() {
    observer?.disconnect();
    if (onScroll) {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    }
    cancelAnimationFrame(raf);

    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!nav) return;
    nav.classList.remove("is-light");

    const bands = [...document.querySelectorAll<HTMLElement>("[data-band]")];
    bands.forEach((b) => b.classList.remove("is-light"));

    const trigger = document.querySelector<HTMLElement>("[data-band-trigger]");
    const statics = [...document.querySelectorAll<HTMLElement>("[data-theme-light]")];
    const over = new Set<Element>();
    let lit = false;
    const syncNav = () => nav.classList.toggle("is-light", over.size > 0 || lit);

    // Static light sections (case studies): straddle test, nav only.
    if (statics.length) {
      observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) over.add(e.target);
            else over.delete(e.target);
          }
          syncNav();
        },
        { rootMargin: `-${SWITCH}px 0px -100% 0px`, threshold: 0 },
      );
      statics.forEach((t) => observer!.observe(t));
    }

    if (trigger && bands.length) {
      const sync = () => {
        raf = 0;
        const se = document.scrollingElement || document.documentElement;
        const top = trigger.getBoundingClientRect().top;

        // The switch line is not always reachable. It assumes the page can
        // scroll far enough to bring the trigger up to y=217, and on a viewport
        // tall relative to the content BELOW the trigger it cannot: on Home at
        // 1080x1900, scrolled to the very bottom, the trigger's top is still
        // 419. `lit` then never became true and the light state — the whole
        // point of the band — never appeared at all.
        //
        // So when the line is out of reach, use the highest position the page
        // can actually deliver, plus a lead-in so the change still happens
        // while you are scrolling rather than exactly at the last pixel. On
        // every viewport where the real line IS reachable this computes to
        // SWITCH and nothing about the tuned behaviour changes.
        const maxScroll = Math.max(0, se.scrollHeight - window.innerHeight);
        const lowestReachableTop = top + se.scrollTop - maxScroll;
        const line = Math.max(SWITCH, Math.min(lowestReachableTop + 120, window.innerHeight / 2));

        // Only commit on a definite cross; inside the dead zone, hold.
        if (top <= line) lit = true;
        else if (top > line + HYSTERESIS) lit = false;
        bands.forEach((band) => band.classList.toggle("is-light", lit));
        syncNav();
      };
      onScroll = () => {
        if (!raf) raf = requestAnimationFrame(sync);
      };
      sync();
      window.addEventListener("scroll", onScroll, { passive: true });
      // The trigger's top moves when the layout reflows, not only when we scroll.
      window.addEventListener("resize", onScroll, { passive: true });
    } else {
      syncNav();
    }
  }

  boot();
  bootMenu();
  document.addEventListener("astro:page-load", () => {
    boot();
    bootMenu();
  });
  // A route change must not leave the panel open over the new page.
  document.addEventListener("astro:before-swap", () => closeMenu?.());
</script>
