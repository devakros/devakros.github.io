---
import LogoFlip from "./LogoFlip.astro";

/**
 * Figma `menu dark version` (1007:5859) — 962x66, #1A1E1E on a 1px #2A3231
 * hairline, 10px radius, sits at y=34 and sticks there.
 *
 * `menu light version` (942:72, #F6F6F6) is the same component re-themed. It
 * exists for exactly one reason: the nav crosses the light band that starts at
 * y=2036, so it inverts on scroll rather than being a user-facing toggle.
 */
interface Props {
  /** Case-study pages use the wider body container so the nav's left/right
      edges line up with the copy + screenshots below it. */
  wide?: boolean;
}
const { wide = false } = Astro.props;

const links = [
  { label: "Proyectos", href: "#proyectos" },
  { label: "Sobre mi", href: "#sobre-mi" },
  { label: "Resumen", href: "#resumen" },
];
---

<header class:list={["nav", wide ? "container-wide" : "container"]} data-nav data-intro-hide>
    <LogoFlip scale={1} />

    <nav class="nav__right" aria-label="Principal">
      {
        links.map((link, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true" />}
            {/* Per-character roll (marrow.au): each letter is a clipped window
                holding the letter twice, stacked. On hover they slide up in
                sequence. The visible copy is aria-hidden and the accessible
                name comes from the sr-only span. */}
            <a class="nav__link" href={link.href} style={`--ni:${i}`}>
              <span class="sr-only">{link.label}</span>
              <span class="roll" aria-hidden="true">
                {[...link.label].map((ch, c) => (
                  <span class="roll__char" style={`--i:${c}`}>
                    <span class="roll__inner">
                      <span class="roll__face">{ch === " " ? " " : ch}</span>
                      <span class="roll__face">{ch === " " ? " " : ch}</span>
                    </span>
                  </span>
                ))}
              </span>
            </a>
          </>
        ))
      }
      <a class="nav__cta" href="#contacto" data-contact-open>¡Hablemos!</a>
    </nav>
</header>

<style>
  /* A sticky element only travels within its containing block. Wrapping the
     nav in a 100px-tall div meant it stuck for 100px and then scrolled away
     with the wrapper — so the nav is a direct child of <body> instead, whose
     box spans the whole page.
     `margin-top` (not the wrapper's padding) supplies the 34px offset: the
     natural position and the sticky `top` then agree, so nothing shifts at
     scroll 0. body has `display: flow-root` to stop that margin collapsing. */
  .nav {
    position: sticky;
    top: 34px;
    z-index: 100;
    margin-top: 34px;
    margin-bottom: 29px; /* hero row starts at y=129; nav bottom is y=100 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 66px;
    padding: 10px 13px 10px 20px;
    background: var(--nav-bg);
    border: 1px solid var(--nav-border);
    border-radius: var(--r-md);
    transition:
      background-color 400ms ease,
      border-color 400ms ease,
      color 400ms ease;
  }

  /* Applied by the scroll observer once the nav overlaps the light band.
     Redefining the tokens locally means LogoFlip and the links re-theme
     without knowing anything about the flip. */
  .nav.is-light {
    --nav-bg: #f6f6f6;
    --nav-border: #e2e5e4;
    --text: #4a5856;
    --muted: #9aa5a3;
    --on-accent: #4a5856;
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Entrance stagger. The bar itself slides down (tokens.css); once it lands,
     the logo, links and CTA settle in one after another. `both` fill holds each
     item at its from-state through its delay, so nothing flashes early. Gated
     on .did-intro — added by the intro script only on the real first-load
     sequence — so client-side navigations don't replay it. */
  .nav.did-intro :is(.logo, .nav__link, .nav__cta) {
    animation: nav-item-in 540ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .nav.did-intro .logo {
    animation-delay: 150ms;
  }
  .nav.did-intro .nav__link {
    animation-delay: calc(220ms + var(--ni, 0) * 70ms);
  }
  .nav.did-intro .nav__cta {
    animation-delay: 450ms;
  }

  @keyframes nav-item-in {
    from {
      opacity: 0;
      translate: 0 -7px;
    }
  }

  .nav__link {
    padding: 9px 10px;
    border-radius: var(--r-sm);
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
    color: var(--text);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .nav__link:hover,
  .nav__link:focus-visible {
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* --- Per-character roll ------------------------------------------------ */
  .roll {
    display: inline-flex;
  }

  .roll__char {
    display: inline-block;
    height: 20.2px; /* the link's line-height — the clip window */
    overflow: hidden;
  }

  .roll__inner {
    display: block;
    transition: transform 420ms cubic-bezier(0.76, 0, 0.24, 1);
    /* Stagger left-to-right; 22ms per character reads as one wave, not
       seven separate animations. */
    transition-delay: calc(var(--i) * 22ms);
  }

  .roll__face {
    display: block;
    height: 20.2px;
    line-height: 20.2px;
    white-space: pre;
  }

  .nav__link:hover .roll__inner,
  .nav__link:focus-visible .roll__inner {
    transform: translateY(-20.2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .roll__inner {
      transition: none;
    }
    .nav__link:hover .roll__inner,
    .nav__link:focus-visible .roll__inner {
      transform: none;
    }
    .nav.did-intro :is(.logo, .nav__link, .nav__cta) {
      animation: none;
    }
  }

  .sep {
    width: 1px;
    height: 12px;
    background: var(--muted);
    flex: none;
  }

  .nav__cta {
    padding: 9px 10px;
    border-radius: var(--r-sm);
    background: var(--accent);
    color: #1d2222;
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 400;
    transition: filter 200ms ease;
  }

  .nav__cta:hover,
  .nav__cta:focus-visible {
    filter: brightness(1.08);
  }

  @media (max-width: 720px) {
    .nav {
      padding: 10px 12px;
      height: 58px;
    }
    /* The three text links collapse; the CTA is the one that has to survive. */
    .nav__link,
    .sep {
      display: none;
    }
  }
</style>

<script>
  // Everything re-themes against one horizontal line at y=217 (the nav's own
  // vertical centre once it has stuck). Two mechanisms feed it:
  //
  //  · [data-band] — Home's three surfaces: the statement/KPI block, the logo
  //    wall, and the testimonials/footer block. They all flip TOGETHER, and
  //    ONE element decides when: the logo wall, marked [data-band-trigger].
  //    The whole screen is meant to toggle as the brand logos reach the line —
  //    per Victor the change belongs at the logos and nowhere else, so do not
  //    give the other two bands their own trigger. Measuring each band against
  //    the line individually is the obvious implementation and it is wrong: it
  //    staggers the change into three separate events down the page.
  //
  //    The test is position-only (top ≤ line), so the bands stay light once the
  //    wall has scrolled up and off; a straddle test would flip them back to
  //    dark while the wall is still on screen, which flashes black. It reverses
  //    on the way back up — the bands toggle both ways.
  //  · [data-theme-light] — the case-study footers, which are permanently
  //    light and never flip. They only need to tell the nav to invert, so
  //    they keep the straddle observer.
  //
  // The nav follows whatever surface is under the line: light once the bands
  // have flipped, or while a static light section straddles it.
  const SWITCH = 217;
  // Dead zone below the line. Without it a trackpad resting on the boundary
  // re-triggers the 400ms fade every frame and the band strobes.
  const HYSTERESIS = 20;

  let observer: IntersectionObserver | undefined;
  let onScroll: (() => void) | undefined;
  let raf = 0;

  function boot() {
    observer?.disconnect();
    if (onScroll) {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    }
    cancelAnimationFrame(raf);

    const nav = document.querySelector<HTMLElement>("[data-nav]");
    if (!nav) return;
    nav.classList.remove("is-light");

    const bands = [...document.querySelectorAll<HTMLElement>("[data-band]")];
    bands.forEach((b) => b.classList.remove("is-light"));

    const trigger = document.querySelector<HTMLElement>("[data-band-trigger]");
    const statics = [...document.querySelectorAll<HTMLElement>("[data-theme-light]")];
    const over = new Set<Element>();
    let lit = false;
    const syncNav = () => nav.classList.toggle("is-light", over.size > 0 || lit);

    // Static light sections (case studies): straddle test, nav only.
    if (statics.length) {
      observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) over.add(e.target);
            else over.delete(e.target);
          }
          syncNav();
        },
        { rootMargin: `-${SWITCH}px 0px -100% 0px`, threshold: 0 },
      );
      statics.forEach((t) => observer!.observe(t));
    }

    if (trigger && bands.length) {
      const sync = () => {
        raf = 0;
        const top = trigger.getBoundingClientRect().top;
        // Only commit on a definite cross; inside the dead zone, hold.
        if (top <= SWITCH) lit = true;
        else if (top > SWITCH + HYSTERESIS) lit = false;
        bands.forEach((band) => band.classList.toggle("is-light", lit));
        syncNav();
      };
      onScroll = () => {
        if (!raf) raf = requestAnimationFrame(sync);
      };
      sync();
      window.addEventListener("scroll", onScroll, { passive: true });
      // The trigger's top moves when the layout reflows, not only when we scroll.
      window.addEventListener("resize", onScroll, { passive: true });
    } else {
      syncNav();
    }
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
