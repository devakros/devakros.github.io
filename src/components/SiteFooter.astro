---
import LogoFlip from "./LogoFlip.astro";
import LocalClock from "./LocalClock.astro";
import { withBase } from "../lib/base";
import { getLangFromUrl, homePath } from "../i18n";
import { useTranslations } from "../i18n/ui";

/**
 * Figma Frame 1000003344 (y=3032) plus the footer nav at y=3130 and the
 * Component 28 logo at y=2986. Shared by Home and the case studies.
 */
interface Props {
  /** Home links to in-page anchors; case studies need to go back to Home. */
  home?: boolean;
}
const { home = true } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// `#proyectos` is a DOM id, not copy, so it stays the same in both locales.
const p = (hash: string) => (home ? hash : withBase(`${homePath[lang]}${hash}`));
---

<div class="footer container" id="contacto">
  <LogoFlip scale={1.2727} href={homePath[lang]} />

  <div class="footer__cols">
    <div class="footer__col">
      <a class="t-label footer__primary" href="mailto:devakrossvivas@gmail.com">devakrossvivas@gmail.com</a>
      <a
        class="footer__secondary"
        href="https://www.linkedin.com/in/victorvivasuxui/"
        rel="me noopener"
        target="_blank">LinkedIn</a
      >
    </div>

    <div class="footer__col footer__col--right">
      <a class="t-label footer__primary" href="tel:+573227806370">+57 322 7806370</a>
      <LocalClock size="footer" place="Colombia, Cucuta" />
    </div>
  </div>

  <nav class="footer__nav" aria-label={t("footer.aria")}>
    <a href={p("#proyectos")}>{t("nav.projects")}</a>
    <span class="sep" aria-hidden="true"></span>
    <a href={withBase("/resumen.pdf")} download>{t("nav.resume")}</a>
  </nav>
</div>

<style>
  /* The three blocks are absolutely positioned siblings in Figma (y=2986 /
     3032 / 3130), not an evenly-gapped stack — so they get their real offsets.
     The logo's -10px is the overlap Component 28 has with the contact row: the
     56px instance overflows its 46px frame. */
  .footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding-top: 108px;
  }

  .footer :global(.logo) {
    margin-bottom: -10px;
  }

  .footer__cols {
    display: flex;
    justify-content: space-between;
    width: 100%;
    gap: 40px;
    margin-bottom: 20px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  .footer__col--right {
    align-items: flex-end;
    text-align: right;
  }

  .footer__primary {
    color: var(--muted);
    transition: opacity 200ms ease;
  }
  .footer__primary:hover {
    opacity: 0.7;
  }

  .footer__secondary {
    font-size: 16px;
    line-height: 18px;
    font-weight: 300;
    color: var(--muted);
  }
  .footer__secondary:hover {
    text-decoration: underline;
  }

  .footer__nav {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }
  .footer__nav a {
    padding: 9px 10px;
    border-radius: var(--r-sm);
    font-size: 16px;
    line-height: 20.2px;
    font-weight: 300;
  }
  .footer__nav a:hover {
    background: color-mix(in srgb, var(--muted) 10%, transparent);
  }
  .footer__nav .sep {
    width: 1px;
    height: 12px;
    background: var(--muted);
  }

  @media (max-width: 1000px) {
    .footer {
      padding-top: 56px;
    }
  }

  @media (max-width: 720px) {
    .footer__cols {
      flex-direction: column;
      gap: 28px;
    }
    .footer__col--right {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
