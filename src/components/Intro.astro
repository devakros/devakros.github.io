---
/**
 * Entry choreography, per Victor:
 *
 *   1. only the noise background
 *   2. the h1 types itself in
 *   3. a beat to let the message land
 *   4. everything else resolves out of a heavy blur
 *
 * Deliberately NOT an overlay — the page itself starts blurred out, so there's
 * no splash covering content that has already painted. Runs once per session;
 * afterwards navigation uses the page transition instead.
 */
---

<script>
  const REVEALED = "vv:intro-seen";
  // Long enough to read the finished line, short enough that the page doesn't
  // stall waiting. 1900ms was a dead spot; the reveal now staggers in, so the
  // motion itself carries the beat that the pause used to have to.
  const HOLD_MS = 850;

  // Human cadence: each keystroke lands ~20–37ms after the previous one, with a
  // breath before each new word and the occasional longer hesitation. A fixed
  // interval reads as an animation; the jitter is what reads as someone typing,
  // so it survives the speed-up — only the magnitudes are halved.
  function delayFor(afterSpace: boolean): number {
    let d = 20 + Math.random() * 17;
    if (afterSpace) d += 34 + Math.random() * 34;
    if (Math.random() < 0.05) d += 70 + Math.random() * 85;
    return d;
  }

  function reveal() {
    // Stamp the cascade order before dropping is-intro, so each block starts
    // its transition one step after the one above it.
    document.querySelectorAll<HTMLElement>("[data-intro-hide]").forEach((el, i) => {
      el.style.setProperty("--intro-d", `${i * 70}ms`);
    });
    document.documentElement.classList.remove("is-intro");
    document.documentElement.classList.add("is-revealed");
  }

  function runIntro() {
    const title = document.querySelector<HTMLElement>("[data-intro-title]");
    const root = document.documentElement;

    // The inline head script already decided whether the intro runs (it has to
    // happen before first paint). If it didn't set the flag, or there's no
    // heading to type, go straight to the settled state.
    if (!title || !root.classList.contains("is-intro")) {
      reveal();
      return;
    }

    // Repeat visit this session: a quick, quiet reveal — no typing, no long
    // hold, gentler blur/rise (see intro-lite in tokens.css) — so a reload
    // still animates in instead of popping, but doesn't replay the whole show.
    if (root.classList.contains("intro-lite")) {
      window.setTimeout(reveal, 220);
      return;
    }

    // Reduced motion: show the heading immediately, hold, then fade the rest
    // up. Same beats, none of the motion.
    if (root.classList.contains("intro-plain")) {
      window.setTimeout(reveal, 900);
      return;
    }

    try {
      sessionStorage.setItem(REVEALED, "1");
    } catch {
      /* storage blocked — the intro just replays next visit */
    }

    // Split into per-character spans, keeping the existing element structure so
    // the two-tone colouring survives. The text stays real text in the DOM, so
    // screen readers read the heading normally.
    const chars: HTMLElement[] = [];
    const delays: number[] = [];
    let afterSpace = false;
    const split = (node: Node) => {
      for (const child of [...node.childNodes]) {
        if (child.nodeType === Node.TEXT_NODE) {
          const text = child.textContent ?? "";
          if (!text.trim() && !text.includes(" ")) continue;
          const frag = document.createDocumentFragment();
          for (const ch of text) {
            if (/\s/.test(ch)) {
              // Spaces stay plain text nodes. Wrapping them — or using a
              // non-breaking space — stops the heading breaking at word
              // boundaries, so it no longer wraps into its 405px column.
              frag.appendChild(document.createTextNode(ch));
              afterSpace = true;
              continue;
            }
            const span = document.createElement("span");
            span.className = "ch";
            span.textContent = ch;
            chars.push(span);
            delays.push(delayFor(afterSpace));
            afterSpace = false;
            frag.appendChild(span);
          }
          child.replaceWith(frag);
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          split(child);
        }
      }
    };
    split(title);
    // Only now is it safe to show the heading: the characters exist and are
    // individually hidden, so nothing flashes.
    title.classList.add("is-split", "is-typing");

    let i = 0;
    let caret: HTMLElement | null = null;
    const step = () => {
      const span = chars[i];
      span.classList.add("is-in");
      // The caret rides along with the last typed letter. Its blink animation
      // restarts on each new span, so it reads solid while typing and only
      // blinks during hesitations and the final hold.
      caret?.classList.remove("is-caret");
      span.classList.add("is-caret");
      caret = span;
      i++;
      if (i < chars.length) {
        window.setTimeout(step, delays[i]);
        return;
      }
      // Let the caret blink over the finished line while the message lands.
      window.setTimeout(() => {
        caret?.classList.remove("is-caret");
        title.classList.remove("is-typing");
        // Opt the nav into its staggered entrance — same tick as reveal() so it
        // slides in as is-intro drops. Only here (the full typed run), never on
        // repeat visits or client-side swaps.
        document.querySelector("[data-nav]")?.classList.add("did-intro");
        reveal();
      }, HOLD_MS);
    };
    window.setTimeout(step, 380); // a beat of just-the-background first

    // Backstop: never leave the page blurred out if something above fails.
    const typingTotal = delays.reduce((a, b) => a + b, 0);
    window.setTimeout(reveal, 380 + typingTotal + HOLD_MS + 2000);
  }

  runIntro();
  // `astro:page-load` also fires on the FIRST load, which would strip is-intro
  // before the blur ever applied. `astro:after-swap` fires only on client-side
  // navigations, which is what we actually want to guard against.
  document.addEventListener("astro:after-swap", reveal);
</script>
