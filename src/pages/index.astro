---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import LogoFlip from "../components/LogoFlip.astro";
import LocalClock from "../components/LocalClock.astro";
import ProjectSlider, { type Slide } from "../components/ProjectSlider.astro";
import Testimonials from "../components/Testimonials.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Showreel from "../components/Showreel.astro";
import { projects } from "../data/projects";
import { withBase } from "../lib/base";

import Diamond from "../icons/diamond.svg?raw";
import Handshake from "../icons/handshake.svg?raw";
import Signature from "../icons/signature.svg?raw";
import LogoFigma from "../icons/logo-figma.svg?raw";
import LogoFramer from "../icons/logo-framer.svg?raw";

// The slider and the case-study routes read from one source of truth.
const slides: Slide[] = projects.map((project) => ({
  title: project.title,
  img: project.img,
  alt: project.alt,
  tags: project.tags,
  desc: project.desc,
  href: withBase(`/proyectos/${project.slug}`),
  placeholder: project.placeholder,
}));

const kpis = [
  {
    icon: Diamond,
    stat: "+8",
    label: "Años creando soluciones de UX/UI con impacto",
    body: "Mi sólida trayectoria me capacita para liderar y ejecutar con éxito cualquier tipo de proyecto, alineando siempre los principios de usabilidad y experiencia de usuario con los objetivos de negocio.",
  },
  {
    icon: Handshake,
    stat: "+4",
    label: "Empresas que han confiado en mi experiencia",
    body: "He colaborado con empresas de diversas escalas, desde grandes corporaciones hasta medianas y pequeñas empresas, además de impulsar la estrategia de startups en pleno crecimiento.",
  },
  {
    icon: Signature,
    stat: "+17",
    label: "Proyectos donde he dejado mi huella y mi corazón",
    body: "He participado en proyectos de diferentes escalas y modelos, desde soluciones B2B hasta B2C, con experiencia clave en industrias como proptech, fintech y healthtech, entre otras.",
  },
];

// Marquee row (Component 4). Rendered twice for the seamless loop — the Figma
// frame does the same thing: two identical 910px groups inside a 1890px track.
const tools = [
  { name: "Spline", img: withBase("/img/logo-spline.png"), size: 34 },
  { name: "Figma", svg: LogoFigma },
  { name: "Useberry", img: withBase("/img/logo-useberry.png"), size: 38 },
  { name: "Framer", svg: LogoFramer },
  { name: "ChatGPT", img: withBase("/img/logo-gpt.png"), size: 40 },
  { name: "Slack", img: withBase("/img/logo-slack.png"), size: 38 },
  { name: "Relume", img: withBase("/img/logo-relume.png"), size: 38 },
];

// Fewer visible slots than logos, so there's always a spare to rotate in
// without two slots showing the same logo.
const LOGO_SLOTS = 5;

const title = "Victor Vivas — IA Powered product designer";
const description =
  "Product designer y estratega de experiencia de usuario. +8 años creando soluciones de UX/UI con impacto para Coca-Cola, Polestar y LeanCore.";
---

<Base title={title} description={description}>
  <Nav />

  <main>
    <!-- ── Hero ───────────────────────────────────────────────────────── -->
    <section class="hero container">
      <div class="hero__top">
        <h1 class="t-h2 hero__title" data-intro-title>
          IA <span class="muted">-</span> Powered product designer <span class="muted"
            >+ estratega de experiencia de usuario</span
          >
        </h1>
        <div data-intro-hide><LocalClock size="hero" /></div>
      </div>

      <div class="hero__row" id="proyectos" data-intro-hide>
        <ProjectSlider slides={slides} />

        <Showreel width={473} height={522} name="Victor Vivas" role="Product Designer" />
      </div>
    </section>

    <!-- ── Statement + KPIs + tool marquee ────────────────────────────── -->
    <section class="approach" id="sobre-mi" data-intro-hide>
      <p class="t-h1 approach__statement container">
        Mi enfoque combina estética moderna con principios de usabilidad y diseño tradicional, <span
          class="muted">creando productos digitales que no son solo plataformas, sino experiencias.</span
        >
      </p>

      <div class="kpis container">
        {
          kpis.map((kpi) => (
            <article class="kpi">
              <span class="kpi__icon" aria-hidden="true" set:html={kpi.icon} />
              <div class="kpi__headline">
                <span class="t-stat">{kpi.stat}</span>
                <span class="t-label">{kpi.label}</span>
              </div>
              <p class="t-body kpi__body">{kpi.body}</p>
            </article>
          ))
        }
      </div>

      {/* Static logo wall. Each slot holds every logo stacked; one is visible
          at a time and the script slowly cross-fades slots to other logos on a
          staggered timer (see the logowall script). No auto-scroll. */}
      <div class="logowall container" aria-label="Herramientas que uso" data-logowall>
        {
          Array.from({ length: LOGO_SLOTS }).map((_, s) => (
            <div class="logoslot">
              {tools.map((tool, t) => (
                <span class:list={["logoslot__item", t === s && "is-on"]}>
                  {tool.svg ? (
                    <span class="tool" title={tool.name} set:html={tool.svg} />
                  ) : (
                    <span class="tool">
                      <img
                        src={tool.img}
                        alt={tool.name}
                        width={tool.size}
                        height={tool.size}
                        loading="lazy"
                      />
                    </span>
                  )}
                </span>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ── The light band. Everything below y=2036 in the Figma frame. ── -->
    <section class="light theme-light" data-theme-light id="resumen" data-intro-hide>
      <h2 class="t-h2 light__title container">Mira lo que están diciendo de mi...</h2>

      <Testimonials />

      <hr class="rule container" />

      <SiteFooter />
    </section>
  </main>
</Base>

<script>
  // Static logo wall: every few seconds one slot cross-fades to a different
  // logo. Slots are staggered so they never all change at once, and a logo
  // that's currently on screen elsewhere is skipped so no two slots match.
  let wallTimer = 0;

  function bootLogowall() {
    const wall = document.querySelector<HTMLElement>("[data-logowall]");
    if (!wall) return;
    // Reduced motion: leave the wall completely static.
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const slots = [...wall.querySelectorAll<HTMLElement>(".logoslot")];
    if (!slots.length) return;
    const total = slots[0].children.length;
    const slotCount = slots.length;
    const state = slots.map((_, s) => s % total);
    let cursor = 0;

    window.clearInterval(wallTimer);
    wallTimer = window.setInterval(() => {
      const s = cursor % slotCount;
      cursor++;

      // Which logos are visible in the *other* slots right now.
      const shown = new Set(state.filter((_, i) => i !== s));
      let next = (state[s] + slotCount) % total;
      let guard = 0;
      while (shown.has(next) && guard++ < total) next = (next + 1) % total;
      if (next === state[s]) return;

      slots[s].children[state[s]]?.classList.remove("is-on");
      slots[s].children[next]?.classList.add("is-on");
      state[s] = next;
    }, 1600);
  }

  // The interval outlives a client-side navigation otherwise.
  document.addEventListener("astro:before-swap", () => window.clearInterval(wallTimer));
  bootLogowall();
  document.addEventListener("astro:page-load", bootLogowall);
</script>

<style>
  .muted {
    color: var(--muted);
  }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  .hero__title {
    max-width: 405px; /* Figma text node is 405x105 — the wrap is deliberate */
    margin: 0;
    color: var(--text);
  }

  /* Card column starts at y=393, video column at y=286 — same 27px gutter,
     different top offsets, both ending at y=808. */
  .hero__row {
    display: flex;
    align-items: flex-start;
    gap: 27px;
    margin-top: 52px;
  }

  /* The slider column starts at y=393, the video at y=286 — same 27px gutter,
     different top offsets, both ending at y=808. */
  .hero__row > :global(.slider) {
    margin-top: 107px;
  }

  /* ── Approach ─────────────────────────────────────────────────────── */
  .approach {
    margin-top: 116px;
    display: flex;
    flex-direction: column;
    gap: 127px; /* Frame 148 itemSpacing */
  }

  .approach__statement {
    margin: 0 auto;
    max-width: 917px;
    text-align: center;
    color: var(--text);
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 27px;
  }

  .kpi {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 25px;
    background: var(--surface);
    border-radius: var(--r-md);
  }

  .kpi__icon {
    width: 34px;
    height: 34px;
    color: var(--accent);
  }
  .kpi__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .kpi__headline {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
  }

  .kpi__body {
    margin: 0;
    color: var(--text);
  }

  /* ── Tool logo wall ───────────────────────────────────────────────── */
  .logowall {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    /* Keeps the row from stretching edge-to-edge on wide viewports. */
    max-width: 820px;
    margin-inline: auto;
  }

  .logoslot {
    position: relative;
    width: 70px;
    height: 70px;
    flex: none;
  }

  /* All logos for a slot stack in the same box; the crossfade swaps which one
     is lit. Outgoing blurs + shrinks as it fades, incoming does the reverse —
     the closest thing to a "morph" that works across mixed PNG/SVG brand marks
     (a true path morph isn't possible between unrelated logos). */
  .logoslot__item {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    filter: blur(7px);
    transform: scale(0.86);
    transition:
      opacity 900ms ease,
      filter 900ms ease,
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .logoslot__item.is-on {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }

  .tool {
    display: grid;
    place-items: center;
    width: 70px;
    height: 70px;
    color: #fff;
  }
  .tool :global(svg) {
    max-width: 42px;
    max-height: 42px;
  }

  @media (max-width: 720px) {
    .logowall {
      flex-wrap: wrap;
      justify-content: center;
      gap: 28px;
    }
  }

  /* ── Light band ───────────────────────────────────────────────────── */
  .light {
    margin-top: 105px;
    padding: 140px 0 30px;
    background: var(--bg);
    color: var(--text);
  }

  .light__title {
    margin: 0 auto 35px;
    text-align: center;
    color: var(--muted);
  }

  /* Matches the nav hairline (--nav-border, 1px) rather than the heavier
     --rule, so it whispers the section break instead of drawing a hard line. */
  .rule {
    height: 1px;
    margin: 95px auto 0;
    border: 0;
    background: var(--nav-border);
  }

  /* ── Responsive ─────────────────────────────────────────────────────
     No mobile frames exist in the Figma file, so everything below this line
     is invented. It stacks the 962px container and keeps the reading order;
     Victor should review it against real devices. */
  @media (max-width: 1000px) {
    .hero__row {
      flex-direction: column;
      gap: 32px;
    }
    .hero__row > :global(.slider) {
      width: 100%;
      margin-top: 0;
    }
    .video {
      height: auto;
      aspect-ratio: 473 / 522;
    }
    .kpis {
      grid-template-columns: 1fr;
    }
    .approach {
      gap: 72px;
      margin-top: 72px;
    }
    .light {
      margin-top: 72px;
      padding-top: 72px;
    }
    .rule {
      margin-top: 56px;
    }
  }

  @media (max-width: 720px) {
    .hero__top {
      flex-direction: column;
      gap: 20px;
    }
    .hero__title {
      max-width: none;
    }
  }
</style>
