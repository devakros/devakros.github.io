---
import Base from "../../layouts/Base.astro";
import CaseStudy, { type Block } from "../../components/CaseStudy.astro";
import { bySlug } from "../../data/projects";
import { withBase } from "../../lib/base";

/**
 * LeanCore — Sitio Web. The marketing-site companion to the LeanCore Studio
 * app case study.
 *
 * Copy is Victor's own (transcribed from the page frame he supplied): the
 * "Rediseño de LeanCore — arquitectura de información y UI minimalista" angle.
 *
 * Screenshots come straight from the Figma frame (file E8WlEJRIernyQ6J487Fimj,
 * frame 1017:3244), rendered at 3x and resampled to 2x of their display size,
 * then stored as WebP. The earlier set was cropped from a 690px-wide paste and
 * was soft enough to turn the client logo row into grey blobs. Do not re-crop
 * from a screenshot — render the node.
 */
const project = bySlug("leancore-web")!;

const blocks: Block[] = [
  {
    heading: "El desafío",
    lead: "Simplificar la complejidad financiera",
    bullets: [
      {
        term: "Ordenando el caos de productos:",
        body: "El reto principal no era solo estético, sino estructural. Tomamos la decisión difícil de reagrupar y filtrar la arquitectura de información, eliminando la sobrecarga cognitiva para guiar al usuario de forma natural hacia lo que realmente importa.",
      },
      {
        term: "Diseño enfocado en la conversión y la seguridad:",
        body: "Cada decisión de diseño se validó bajo la premisa de que un usuario fintech necesita claridad inmediata para sentirse seguro. Limpiamos los flujos de navegación para reducir el abandono y potenciar la retención.",
      },
    ],
  },
  {
    heading: "Sistema de diseño",
    lead: "Un sistema visual limpio y minimalista",
    paras: [
      "La confianza visual se construye con precisión. Desarrollamos un sistema de diseño minimalista donde cada componente tipográfico, espaciado y retícula cumple una función estricta.",
      "La estandarización de los elementos visuales aseguró que la plataforma se sintiera moderna, coherente y escalable en cualquier dispositivo.",
    ],
  },
  {
    heading: "Handoff",
    lead: "Sincronización y ejecución técnica",
    paras: [
      "Un diseño web minimalista exige una ejecución técnica impecable para mantener la nitidez y el rendimiento. Trabajamos codo a codo con el equipo de desarrollo para cuidar cada detalle de implementación.",
    ],
    bullets: [
      {
        term: "",
        body: "Entrega de especificaciones limpias en Figma para asegurar que la traducción al código respetara la retícula y los espacios en blanco.",
      },
      {
        term: "",
        body: "Sincronización constante para validar que los filtros de información y las interacciones respondieran con fluidez.",
      },
    ],
  },
  {
    heading: "Impacto de negocio",
    lead: "El resultado fue una plataforma que no solo se ve elegante, sino que optimiza el negocio.",
    bullets: [
      {
        term: "Claridad:",
        body: "Reagrupamiento estratégico de productos que facilita la lectura y comprensión del servicio.",
      },
      {
        term: "Confianza:",
        body: "Interfaz minimalista y profesional diseñada específicamente para mitigar la fricción en servicios financieros.",
      },
      {
        term: "Escalabilidad:",
        body: "Una arquitectura web flexible que permite incorporar nuevos productos sin alterar la armonía visual.",
      },
    ],
  },
  {
    heading: "Reflexión",
    lead: "El rediseño de LeanCore me recordó que en el mundo fintech el minimalismo no es solo una elección estética, es una herramienta de conversión y seguridad. La verdadera madurez en UX/UI se demuestra cuando eres capaz de simplificar la complejidad técnica para construir un espacio donde el usuario sienta confianza desde el primer segundo.",
  },
];

// The grid mirrors the Figma frame: a wide phone mock, then a row pairing the
// roadmap video (the design's white-square slot) with a second phone, then the
// desktop landing, then the "flujo nativo" panel.
//
// The roadmap clip was recut on 2026-08-07. The source Victor supplied read as
// broken rather than as a video: it opened on 1.2s of blank grey and closed on
// 0.8s more, it carried ~66px black bars down both sides, and its poster showed
// the FINISHED card — so the page painted a complete card and then cut to an
// empty one the moment playback started.
//
// It still read as frozen after all that, and the cause was not playback: the
// clip simply had nothing visible moving in it. At this tile's 322px, the only
// change across 13 seconds was a few ~6px ticks, one every two seconds. So it
// is also retimed 2.4x faster (5.5s). If you re-cut it, keep all of it: cropped
// to the card, padded square, no dead head or tail, poster == frame 0, and
// enough motion per second to read at 322px. Judge that last one by pixels
// changed at display size — `currentTime` advancing proves nothing.
//
// ⚠️ RENAME THE FILE WHENEVER YOU REPLACE IT. It is `roadmap-v2` and not
// `roadmap-sq` for a reason: the first three recuts all shipped under the same
// filename, so every browser that had already loaded the original kept serving
// it from cache and kept showing the broken clip. The re-exported stills did
// not have this problem only because .png -> .webp changed their URLs by
// accident. Media caches hard, and a full reload revalidates it while a
// client-side navigation does not — which is exactly why it looked fine on
// refresh and dead on navigation. Bump the suffix, do not overwrite.
const shots = [
  { src: withBase("/img/case/leancore-web/shot-1.webp"), w: 1356, h: 1070, alt: "Landing de LeanCore en móvil: 'Mueve dinero, gestiona crédito y escala tu operación'" },
  {
    src: withBase("/img/case/leancore-web/roadmap-v3.webp"),
    bed: true,
    half: true,
    w: 644,
    h: 644,
    alt: "Roadmap del producto LeanCore: despliegue automático de nuevas funciones",
  },
  { src: withBase("/img/case/leancore-web/shot-3.webp"), half: true, w: 644, h: 826, alt: "Detalle móvil de LeanCore: 'Tu operación de crédito empieza hoy'" },
  { src: withBase("/img/case/leancore-web/shot-2.webp"), w: 1356, h: 950, alt: "Página de inicio de LeanCore en escritorio con el mensaje principal y prueba social" },
  { src: withBase("/img/case/leancore-web/shot-4.webp"), w: 1356, h: 900, alt: "Flujo nativo de oportunidades: prospectos calificados con crecimiento de cartera del 97.5%" },
];

const description =
  "Rediseño de LeanCore: arquitectura de información y una UI minimalista para transmitir la confianza que exige el sector fintech.";
---

<Base title={`${project.title} — Victor Vivas`} description={description}>
  <CaseStudy
    slug="leancore-web"
    title={{
      base: "Arquitectura de información y UI minimalista para la confianza fintech",
      muted: "Rediseño de LeanCore:",
    }}
    mutedLead
    tags={["UX", "UI", "Responsive", "Design System", "Prototype"]}
    intro="En el sector fintech, la interfaz es sinónimo de seguridad. El rediseño integral de LeanCore se centró en eliminar el ruido visual para transmitir absoluta confianza y profesionalismo, reestructurando y filtrando la información clave para que los usuarios comprendan su ecosistema de productos sin fricción."
    meta={{ year: "2026", client: "LeanCore" }}
    blocks={blocks}
    shots={shots}
  />
</Base>
