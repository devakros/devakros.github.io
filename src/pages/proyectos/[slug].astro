---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const idx = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(idx + 1) % projects.length];
---

<Base
  title={`${project.title} — Victor Vivas`}
  description={project.placeholder ? `Caso de estudio: ${project.title}.` : project.desc}
>
  <Nav />

  <main class="case">
    {/* The frame render below already contains this project's title, tags,
        video and body — it is the designed page. So the heading here is
        visually hidden (the document still needs one) and the only chrome we
        add is the back link. */}
    <header class="case__head container">
      <a class="case__back" href="/">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 5 8 12l7 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Volver
      </a>

      <h1 class="sr-only">{project.title}</h1>

      {
        project.placeholder && (
          <p class="case__notice">
            PENDIENTE: copy de este caso de estudio. Lo de abajo es el frame de Figma tal cual —
            todavía no está maquetado como HTML.
          </p>
        )
      }
    </header>

    {/* Until each case study is built as real markup, the Figma frame render
        stands in for the body. It keeps the routes real so navigation and
        transitions are reviewable. Its own nav is cropped off so it doesn't
        duplicate the sticky one. */}
    <div class="case__frame container">
      <img
        src={project.frame}
        alt={`Caso de estudio ${project.title}`}
        width="1280"
        height={project.frameHeight}
        loading="eager"
      />
    </div>

    <nav class="case__next container" aria-label="Siguiente proyecto">
      <span class="case__next-label">Siguiente proyecto</span>
      <a class="case__next-link" href={`/proyectos/${next.slug}`}>
        {next.title}
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </nav>

    <SiteFooter home={false} />
  </main>
</Base>

<style>
  .case {
    padding-bottom: 30px;
  }

  .case__head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 16px;
    padding-bottom: 24px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    font-size: 16px;
    line-height: 20.2px;
    color: var(--muted);
    transition: color 200ms ease;
  }
  .case__back svg {
    width: 18px;
    height: 18px;
    transition: translate 200ms ease;
  }
  .case__back:hover {
    color: var(--text);
  }
  .case__back:hover svg {
    translate: -3px 0;
  }

  .case__notice {
    margin: 0;
    padding: 12px 16px;
    border: 1px dashed var(--muted);
    border-radius: var(--r-sm);
    font-size: 16px;
    line-height: 20.2px;
    color: var(--muted);
  }

  .case__frame {
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface);
  }
  .case__frame img {
    width: 100%;
    height: auto;
  }

  .case__next {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-top: 72px;
    flex-wrap: wrap;
  }

  .case__next-label {
    font-size: 16px;
    line-height: 20.2px;
    color: var(--muted);
  }

  .case__next-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 35px;
    line-height: 40px;
    font-weight: 500;
    color: var(--text);
    transition: color 200ms ease;
  }
  .case__next-link svg {
    width: 28px;
    height: 28px;
    transition: translate 250ms ease;
  }
  .case__next-link:hover {
    color: var(--accent);
  }
  .case__next-link:hover svg {
    translate: 5px 0;
  }

  @media (max-width: 720px) {
    .case__next-link {
      font-size: 26px;
      line-height: 30px;
    }
  }
</style>
